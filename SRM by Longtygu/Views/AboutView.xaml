<UserControl x:Class="SRM_by_Longtygu.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" Foreground="#FFFFFF"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- STYLE NÚT BẤM CHUẨN WINDOWS 11 FLUENT DARK MODE -->
        <Style x:Key="FluentTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tùy chỉnh ScrollBar tối màu cho phần Nguyên lý hoạt động -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#555555" CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nâng cấp Style cho các đoạn văn bản kỹ thuật chi tiết -->
        <Style x:Key="DetailTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
        </Style>

        <!-- Style cho từng dòng trong danh sách Nhật ký hoạt động, đổi màu viền trái theo Level -->
        <Style x:Key="LogRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="#60CDFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARNING">
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="BorderBrush" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogLevelBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#60CDFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARNING">
                    <Setter Property="Background" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Background" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: MENU CHỌN -->
        <Border Grid.Column="0" Background="#282828" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">

                <Button Command="{Binding ShowAppInfoCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingAppInfo}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="#60CDFF"/>
                        <TextBlock Text="{DynamicResource About_ApplicationInformation}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowOperatingPrincipleCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingOperatingPrinciple}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Cogs" Width="18" Height="18" Margin="0,0,12,0" Foreground="#FF9800"/>
                        <TextBlock Text="{DynamicResource About_HowItWorks}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowActivityLogCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingActivityLog}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="#6CCB5F"/>
                        <TextBlock Text="{DynamicResource About_ActivityLog}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- CỘT PHẢI: NỘI DUNG HIỂN THỊ -->
        <Grid Grid.Column="1" Margin="40,30,40,30">

            <!-- GIAO DIỆN 1: THÔNG TIN APP -->
            <StackPanel Visibility="{Binding IsShowingAppInfo, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Background="#2D2D2D" Width="64" Height="64" CornerRadius="12" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="HexagonMultiple" Width="36" Height="36" Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Software Repository Manager" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource About_VersionLabel}" FontSize="14" Foreground="#888888" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#282828" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                    <FlowDocumentScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                        <FlowDocument FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="15" Foreground="#CCCCCC" TextAlignment="Justify" PagePadding="5">
                            <Paragraph LineHeight="24">
                                <Floater HorizontalAlignment="Left" Width="180" Margin="0,0,20,10">
                                    <BlockUIContainer>
                                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#444444" BorderThickness="1">
                                            <Image Source="pack://application:,,,/Resources/Images/author_portrait.png" Stretch="UniformToFill" Height="240" Width="180" ToolTip="{DynamicResource About_Author}"/>
                                        </Border>
                                    </BlockUIContainer>
                                </Floater>
                                <Run Text="{DynamicResource About_SoftwareRepositoryManagerSRM}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource About_About70OfThe}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource About_100OfTheCode}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource About_TheMainFeaturesCurrently}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{DynamicResource About_SinceThisIsPersonal}"/>
                            </Paragraph>
                            <BlockUIContainer>
                                <Button x:Name="FacebookButton"
                                        Click="FacebookButton_Click"
                                        Style="{StaticResource FluentTabButtonStyle}"
                                        Background="#2D2D2D" Foreground="#FFFFFF"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                                        ToolTip="https://www.facebook.com/longtygu/">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="OpenInNew" Width="16" Height="16" Margin="0,0,10,0" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource About_ContactViaFacebook}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </BlockUIContainer>
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Border>
            </StackPanel>

            <!-- GIAO DIỆN 2: ĐẶC TẢ KIẾN TRÚC & NGUYÊN LÝ HOẠT ĐỘNG (BẢN CHI TIẾT) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingOperatingPrinciple}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                    <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource About_ArchitectureSpecificationHow}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bọc nội dung trong Card có ScrollViewer -->
                <Border Grid.Row="1" Background="#282828" CornerRadius="8" Padding="25" BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="0,0,10,0">

                            <!-- 1. Kiến trúc CSDL -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="Database" Width="20" Height="20" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource About_1DatabaseArchitectureState}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="{DynamicResource About_TheStorageSystemIs}"/>
                                    <Run Text="DatabaseBootstrapper" FontWeight="Bold" Foreground="#6CCB5F"/>
                                    <Run Text="{DynamicResource About_ClassWillAutomaticallyComput}"/>
                                    <Run Text="AppDomain.CurrentDomain.BaseDirectory" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_ToGenerateTheFile}"/>
                                    <Run Text="library.db" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_ThisGuaranteesAbsolute}"/>
                                    <Run Text="Portable" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_BehaviorWhenTheApp}"/>
                                    <Run Text="FOREIGN KEY" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_CombinedWith}"/>
                                    <Run Text="ON DELETE CASCADE" FontWeight="Bold" Foreground="#FF5252"/>
                                    <Run Text="{DynamicResource About_WhenAParentSoftware}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 2. Luồng Triển khai -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20" Foreground="#FF5252" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource About_2LowLevelInstallation}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="{DynamicResource About_TheOrchestrationModuleDeploy}"/>
                                    <Run Text="Verb = 'runas'" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_ToCallTheFunction}"/>
                                    <Run Text="Enable-ComputerRestore" FontWeight="Bold" Foreground="#60CDFF"/>
                                    <Run Text="{DynamicResource About_ThroughTheWindowsAPI}"/>
                                    
                                    <Run Text="{DynamicResource About_ForPortableSoftware}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Run Text="{DynamicResource About_TheSystemUses}"/>
                                    <Run Text="ZipFile.ExtractToDirectory" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_ToExtractDirectlyInto}"/>

                                    <Run Text="{DynamicResource About_ForSilentInstallers}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Run Text="{DynamicResource About_ToSolveTheProblem}"/>
                                    <Run Text="RunSilentInstallAsync" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_UsesAPollingLoop}"/>
                                    <Run Text="!process.HasExited" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_ItContinuouslyFeedsRandom}"/>
                                    <Run Text="Random.Next" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_ToSlowlyPushThe}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 3. Analyzer -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="Brain" Width="20" Height="20" Foreground="#C381FD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource About_3PackageStructureAnalysis}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="{DynamicResource About_TheCore}"/>
                                    <Run Text="InstallerAnalyzer" FontWeight="Bold" Foreground="#C381FD"/>
                                    <Run Text="{DynamicResource About_WorksAsAStatic}"/>
                                    <Run Text="{DynamicResource About_TheFirst2MBOf}" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_ThisBinaryBlockIs}"/>
                                    <Run Text="/VERYSILENT" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_NullsoftNSISInstallers}"/>
                                    <Run Text="/S" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_OrWiXToolset}"/>
                                    <Run Text="-quiet" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_InUnder01}"/>
                                    <Run Text="INSTALLDIR" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_DriveRoutingVariablesWithout}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 4. Plugin -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="PuzzleOutline" Width="20" Height="20" Foreground="#FFB86C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource About_4OpenArchitectureDependency}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="{DynamicResource About_BuiltOnAModern}"/>
                                    <Run Text="IToolModule" FontWeight="Bold" Foreground="#FFB86C"/>
                                    <Run Text="{DynamicResource About_ExternalDLLsOnlyNeed}"/>
                                    <Run Text="Id, IconKind" FontStyle="Italic"/>
                                    <Run Text="{DynamicResource About_SoTheUICan}"/>
                                    <Run Text="CreateView(IServiceProvider)" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource About_SRMPassesAllInternal}"/>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- GIAO DIỆN 3: NHẬT KÝ HOẠT ĐỘNG (LOG VIEWER) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingActivityLog}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline" Width="28" Height="28" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource About_ActivityLog}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Thanh công cụ: chọn ngày, làm mới, mở thư mục -->
                <Border Grid.Row="1" Background="#282828" CornerRadius="8" Padding="15,12" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource About_Date}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLogDates}"
                                  SelectedItem="{Binding SelectedLogDate}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='dd/MM/yyyy'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="{Binding LogStatusText}" Foreground="#888888" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="3" Content="{DynamicResource Library_Refresh}" Command="{Binding RefreshLogCommand}"
                                Style="{StaticResource FluentTabButtonStyle}" Margin="4,0" Padding="14,8"/>

                        <Button Grid.Column="4" Content="{DynamicResource About_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource FluentTabButtonStyle}" Margin="4,0" Padding="14,8"/>
                    </Grid>
                </Border>

                <!-- Danh sách log -->
                <Border Grid.Row="2" Background="#282828" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LogRowStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Style="{StaticResource LogLevelBadgeStyle}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"/>
                                                </Border>
                                                <TextBlock Text="{Binding TimeDisplay}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="14"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#FF8A80" TextWrapping="Wrap" FontSize="12"
                                                       FontFamily="Consolas" Margin="0,6,0,0"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>