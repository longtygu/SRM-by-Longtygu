<UserControl x:Class="SRM_by_Longtygu.Tools.HardwareInfo.HardwareInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SensorRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MonitorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#1E1E1E" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2A2A2A" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                <iconPacks:PackIconMaterial Kind="Chip" Width="22" Height="22" Foreground="#60CDFF"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Thông tin phần cứng" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="AdminHintText" Text="" FontSize="12" Foreground="#E8A23D" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="RestartAsAdminButton"
                    Content="⚠ Chạy lại với quyền Admin"
                    Background="#E8A23D" Foreground="#202020" FontWeight="SemiBold"
                    Padding="14,8" BorderThickness="0" Cursor="Hand"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Click="RestartAsAdminButton_Click" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== TAB BUTTONS ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="TabOverviewButton" Content="Tổng quan" Style="{StaticResource TabButtonStyle}"
                    Click="TabOverview_Click" Margin="0,0,6,0"/>
            <Button x:Name="TabMonitorButton" Content="Giám sát thời gian thực" Style="{StaticResource TabButtonStyle}"
                    Click="TabMonitor_Click" Margin="0,0,6,0"/>
            <Button x:Name="TabSmartButton" Content="S.M.A.R.T ổ đĩa" Style="{StaticResource TabButtonStyle}"
                    Click="TabSmart_Click"/>
        </StackPanel>

        <!-- ===== NỘI DUNG ===== -->
        <Grid Grid.Row="2">

            <!-- ===== TAB: TỔNG QUAN (dạng bảng dọc kiểu Windows About) ===== -->
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,20">

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chi tiết cấu hình hệ thống" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#909090" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Xuất file TXT" Style="{StaticResource ActionButtonStyle}"
                                Background="#3A6FA0" Foreground="White" Click="ExportOverviewButton_Click"/>
                    </Grid>

                    <Border Background="#232323" CornerRadius="10" Padding="20,4">
                        <StackPanel x:Name="OverviewRowsPanel"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== TAB: GIÁM SÁT THỜI GIAN THỰC ===== -->
            <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>

                    <!-- Ghi chú về hạn chế cảm biến -->
                    <TextBlock Text="Một số cảm biến (nhiệt độ/xung nhịp/công suất CPU-GPU) cần quyền Administrator hoặc có thể không được driver hỗ trợ trên phần cứng đời cũ."
                               FontSize="12" Foreground="#707070" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Biểu đồ nhiều đường real-time: Tải % (Load) của từng linh kiện, mỗi đường 1 màu -->
                    <Border Background="#161616" CornerRadius="8" Padding="14" Margin="0,0,0,14" Height="190">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="Giám sát tải theo thời gian thực (%)" FontSize="13" Foreground="#909090"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <StackPanel x:Name="ChartLegendPanel" Orientation="Horizontal"/>
                            </StackPanel>

                            <Canvas x:Name="RealtimeChartCanvas" Grid.Row="1" ClipToBounds="True" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Card phần cứng: tạo động theo CPU / GPU / RAM / Ổ đĩa thực tế phát hiện được -->
                    <StackPanel x:Name="MonitorCardsPanel"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== TAB: S.M.A.R.T Ổ ĐĨA ===== -->
            <Grid x:Name="SmartPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Chọn ổ đĩa:" FontSize="14" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="DriveSelectorComboBox" Width="380" FontSize="14" HorizontalAlignment="Left"
                              SelectionChanged="DriveSelectorComboBox_SelectionChanged"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SmartRowsPanel"/>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
