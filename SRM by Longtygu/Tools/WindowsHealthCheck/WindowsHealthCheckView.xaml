<UserControl x:Class="SRM_by_Longtygu.Tools.WindowsHealthCheck.WindowsHealthCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>

        <!-- ============ NÚT CHÍNH (ACCENT) ============ -->
        <Style x:Key="FluentAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#60CDFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#7ED6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4BB8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NÚT NGUY HIỂM (CHKDSK /F, HỦY) ============ -->
        <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentAccentButton}">
            <Setter Property="Background" Value="#E06C75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8858D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C85A63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NÚT GHOST (TRONG SUỐT, VD "Làm mới" / "Xóa nhật ký") ============ -->
        <Style x:Key="FluentGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60CDFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ CARD KIỂU "MICA" ============ -->
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- ============ ICON BADGE TRÒN CHO TIÊU ĐỀ MỖI CARD ============ -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#1A60CDFF"/>
        </Style>

        <!-- ============ COMBOBOX ITEM ============ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ COMBOBOX CHỌN Ổ ĐĨA (CHKDSK) ============ -->
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#A0A0A0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2E2E2E" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="200" Margin="0,4,0,0" SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ THANH CUỘN TỐI MÀU (áp dụng ngầm cho mọi ScrollViewer trong view) ============ -->
        <Style x:Key="FluentScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A4A4A" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand">
                                                <RepeatButton.Template>
                                                    <ControlTemplate>
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand">
                                                <RepeatButton.Template>
                                                    <ControlTemplate>
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource FluentScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TIÊU ĐỀ ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Windows Health Check" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#60CDFF" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ============ BANNER CẢNH BÁO THIẾU QUYỀN ADMIN ============ -->
        <Border Grid.Row="1" Background="#2A2416" BorderBrush="#3AE3B341" BorderThickness="1" CornerRadius="8"
                Padding="14,10" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdministrator}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <iconPacks:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Foreground="#E3B341"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Ứng dụng đang chạy không có quyền Administrator. DISM, SFC, CHKDSK và một số mục kiểm tra (BitLocker...) có thể không hoạt động đầy đủ."
                               FontSize="12" Foreground="#E3B341" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RestartAdminButton" Content="Chạy lại với quyền Admin"
                        Click="RestartAsAdminButton_Click"
                        Style="{StaticResource FluentAccentButton}" Width="190"/>
            </Grid>
        </Border>

        <!-- ============ NỘI DUNG CHÍNH: TRÁI = nút/trạng thái, PHẢI = log thu gọn ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>

                    <!-- ============ CARD: TÌNH TRẠNG HỆ THỐNG ============ -->
                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Style="{StaticResource IconBadge}">
                                        <iconPacks:PackIconMaterial Kind="ClipboardPulseOutline" Width="16" Height="16"
                                                                     Foreground="#60CDFF"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tình trạng hệ thống" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="⟳ Làm mới" Command="{Binding RefreshStatusCommand}"
                                        Style="{StaticResource FluentGhostButton}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding HealthItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2E2E2E" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                CornerRadius="10" Padding="14,12" Margin="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                        Background="#1A60CDFF" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="17" Height="17"
                                                                                 Foreground="#60CDFF"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{Binding StateChipBackground}" CornerRadius="20"
                                                                Padding="8,3" VerticalAlignment="Top" Margin="6,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="{Binding StateIconKind}" Width="11" Height="11"
                                                                                             Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StateLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding StateColor}" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#B0B0B0"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="#6E6E6E"
                                                               TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ============ CARD: CÔNG CỤ SỬA LỖI ============ -->
                    <Border Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource IconBadge}">
                                    <iconPacks:PackIconMaterial Kind="Wrench" Width="16" Height="16"
                                                                 Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Công cụ sửa lỗi hệ thống" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- ===== Panel nút khi KHÔNG có tác vụ nào đang chạy ===== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepairRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="DISM RestoreHealth" Command="{Binding RunDismCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="195" Margin="0,0,10,10"/>
                                    <Button Content="SFC /scannow" Command="{Binding RunSfcCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="195" Margin="0,0,10,10"/>
                                    <Button Content="Reset Network" Command="{Binding ResetNetworkCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="195" Margin="0,0,10,10"/>
                                    <Button Content="Flush DNS" Command="{Binding FlushDnsCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="195" Margin="0,0,10,10"/>
                                    <Button Content="Repair Windows Update" Command="{Binding RepairWindowsUpdateCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="195" Margin="0,0,10,10"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CHKDSK ổ:" Foreground="#A0A0A0" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Style="{StaticResource FluentComboBox}"
                                              ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedChkdskDrive}"
                                              Width="90" Margin="0,0,10,0"/>
                                    <Button Content="Scan (chỉ đọc)" Command="{Binding RunChkdskScanCommand}"
                                            Style="{StaticResource FluentAccentButton}" Width="150" Margin="0,0,10,0"/>
                                    <Button Content="Scan + Fix (/f)" Command="{Binding RunChkdskFixCommand}"
                                            Style="{StaticResource FluentDangerButton}" Width="150"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== Panel khi ĐANG chạy tác vụ ===== -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepairRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Đang chạy: " FontSize="13.5" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentRepairName}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="#60CDFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Theo dõi chi tiết trong nhật ký bên dưới. Quá trình này có thể mất vài phút."
                                           FontSize="11.5" Foreground="#6E6E6E" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Button Content="Hủy tác vụ" Command="{Binding CancelRepairCommand}"
                                        Style="{StaticResource FluentDangerButton}" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="13" Height="13" Foreground="#6E6E6E"
                                                             VerticalAlignment="Top" Margin="0,2,6,0"/>
                                <TextBlock Text="Các công cụ này cần quyền Administrator. CHKDSK Scan + Fix trên ổ hệ thống có thể tự lên lịch kiểm tra vào lần khởi động lại tiếp theo."
                                           FontSize="10.5" Foreground="#6E6E6E" TextWrapping="Wrap" Width="600"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ============ CARD: NHẬT KÝ (LOG CONSOLE) — thu gọn, ghim cố định bên phải ============ -->
            <Border Grid.Column="1" Style="{StaticResource FluentCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ConsoleLine" Width="15" Height="15"
                                                         Foreground="#60CDFF" VerticalAlignment="Center"/>
                            <TextBlock Text="Nhật ký" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Xóa" Command="{Binding ClearLogCommand}"
                                Style="{StaticResource FluentGhostButton}" Padding="6,4" FontSize="11"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8,6">
                            <TextBlock Text="{Binding LogText}" Foreground="#D0D0D0"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
