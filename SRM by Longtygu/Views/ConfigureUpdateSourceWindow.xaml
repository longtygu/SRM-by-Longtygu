<Window x:Class="SRM_by_Longtygu.Views.ConfigureUpdateSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:SRM_by_Longtygu.Converters"
        Title="Cấu hình kiểm tra cập nhật" Height="760" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- MỚI: Ẩn banner gợi ý khi SuggestionMessage rỗng/null -->
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>

        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem trong dropdown - phải style riêng, nếu không sẽ dùng theme hệ thống (nền trắng) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A4B6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox - PHẢI có ControlTemplate riêng đầy đủ (kể cả Popup), nếu không phần dropdown sẽ
             rơi về theme mặc định của Windows (nền trắng) trong khi Foreground ta set lại là trắng -> mất chữ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               IsHitTestVisible="False"
                                               TextElement.Foreground="{TemplateBinding Foreground}"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <ToggleButton x:Name="ToggleBtn" Grid.Column="1" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M0,0 L5,5 L10,0 Z" Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide"
                                   MinWidth="{TemplateBinding ActualWidth}">
                                <Border Background="#2D2D2D" BorderBrush="#454545" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FluentButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Background" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Border Background="#202020" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconMaterial Kind="CloudSyncOutline" Foreground="#60CDFF" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cấu hình kiểm tra cập nhật" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="45" Click="CloseButton_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="12" Height="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Border Margin="24,0,24,24" Background="#282828" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding SoftwareName, StringFormat='Nguồn cập nhật cho: {0}'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#60CDFF"/>

                        <!-- MỚI: Banner gợi ý tự động từ catalog -->
                        <Border Background="#1F2937" CornerRadius="6" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding SuggestionMessage, Converter={StaticResource StringToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="AutoFix" Width="16" Height="16" Foreground="#60CDFF" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding SuggestionMessage}" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding AutoSuggestCommand}" Background="Transparent" BorderThickness="0"
                                        Foreground="#60CDFF" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Padding="8,0,0,0" Content="Dò lại"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Loại nguồn" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSourceOption}" Margin="0,0,0,20"/>

                        <!-- Chế độ Winget -->
                        <StackPanel Visibility="{Binding IsWingetMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ID gói Winget" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Text="{Binding UpdateSourceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" FontFamily="Consolas"/>
                            <TextBlock Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20">
                                VD: VideoLAN.VLC — mở CMD gõ "winget search &lt;tên phần mềm&gt;" để tra đúng ID (cột Id).
                                Máy cần có sẵn Winget và kết nối mạng lúc quét/cài.
                            </TextBlock>
                        </StackPanel>

                        <!-- Chế độ GitHub -->
                        <StackPanel Visibility="{Binding IsGitHubMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Repo GitHub (dạng owner/repo)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Text="{Binding UpdateSourceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="VD: videolan/vlc — app sẽ gọi GitHub Releases API để lấy tag_name mới nhất." Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- Chế độ Regex trang web -->
                        <StackPanel Visibility="{Binding IsRegexMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="URL trang cần quét" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Text="{Binding UpdateSourceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                            <TextBlock Text="Regex lấy số phiên bản (1 capture group)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Text="{Binding UpdateVersionPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" FontFamily="Consolas"/>
                            <TextBlock Text="VD: Phi.n b.n[^\d]*(\d+(?:\.\d+)+)" Foreground="#777777" FontSize="11" Margin="0,0,0,14"/>

                            <TextBlock Text="Regex lấy link tải (tuỳ chọn, 1 capture group)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Text="{Binding UpdateDownloadPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" FontFamily="Consolas"/>
                            <TextBlock Text="VD: href=&quot;([^&quot;]+\.exe)&quot;. Để trống nếu chỉ muốn báo có bản mới, không tự tải." Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="15,12" Margin="0,0,8,0">
                                <TextBlock Text="Huỷ" FontWeight="SemiBold"/>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SaveCommand}" Style="{StaticResource FluentButtonStyle}" Background="#16A34A" Padding="15,12" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                    <TextBlock Text="Lưu cấu hình" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Background="#CC000000" Panel.ZIndex="99" Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Autorenew" Width="40" Height="40" Foreground="#60CDFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </iconPacks:PackIconMaterial.Triggers>
                            <iconPacks:PackIconMaterial.RenderTransform>
                                <RotateTransform CenterX="20" CenterY="20"/>
                            </iconPacks:PackIconMaterial.RenderTransform>
                        </iconPacks:PackIconMaterial>
                        <TextBlock Text="Đang lưu..." Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
