<Window x:Class="SRM_by_Longtygu.Views.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:SRM_by_Longtygu.Helpers"
        Title="Thiết kế Gói Cài Đặt (Preset)" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" 
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <helpers:ImagePathConverter x:Key="ImgConverter"/>

        <!-- STYLE NÚT ĐÓNG (CLOSE BUTTON) -->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FluentButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="FluentComboBoxStyle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#282828" BorderBrush="#454545" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200" CornerRadius="4" Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SharedGroupItemStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="#2D2D2D" BorderThickness="0,0,0,1" BorderBrush="#3E3E3E" Margin="0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="5,12">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} ứng dụng)'}" Foreground="#888888" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter Margin="16,0,0,0"/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- BỌC TOÀN BỘ WINDOW ĐỂ TẠO BO GÓC VÀ NỀN DARK MODE -->
    <Border Background="#202020" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <!-- Hàng cho Thanh Tiêu đề (Title bar) -->
                <RowDefinition Height="*"/>
                <!-- Hàng cho Nội dung chính -->
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconMaterial Kind="PackageVariant" Foreground="#60CDFF" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thiết kế Gói Cài Đặt (Preset)" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nút Đóng (X) -->
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="45" Click="CloseButton_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- NỘI DUNG CHÍNH (Đã được bê vào Row 1 và căn chỉnh lề) -->
            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="#282828" CornerRadius="8" Padding="20" Margin="0,0,0,24" BorderBrush="#333333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding SelectIconCommand}" Style="{StaticResource FluentButtonStyle}" Background="#333333" Width="90" Height="90" ToolTip="Click để đổi Icon">
                            <Grid>
                                <iconPacks:PackIconMaterial Kind="ImagePlus" Foreground="#888888" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding PresetIconPath, Converter={StaticResource ImgConverter}}" Stretch="Uniform" Width="86" Height="86"/>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tên Gói Cài Đặt (Preset Name)" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Background="#333333" Foreground="#FFFFFF" BorderBrush="#454545" BorderThickness="1" Padding="12" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: KHO PHẦN MỀM -->
                    <Border Grid.Column="0" Background="#282828" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thanh Công Cụ -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Cột 1: Thanh tìm kiếm sẽ chiếm toàn bộ không gian còn lại -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Cột 2: Nút Đổi góc nhìn -->
                                </Grid.ColumnDefinitions>

                                <!-- Ô Tìm Kiếm -->
                                <Border Grid.Column="0" Background="#333333" CornerRadius="6" Padding="12,8" BorderBrush="#454545" BorderThickness="1" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconMaterial Grid.Column="0" Kind="Magnify" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Đã xóa Width="250" và dùng Grid để TextBox tự động kéo dài hết cỡ -->
                                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="14"/>
                                    </Grid>
                                </Border>

                                <!-- Nút Đổi góc nhìn -->
                                <Button Grid.Column="1" Command="{Binding ToggleViewCommand}" Style="{StaticResource FluentButtonStyle}" Background="#0284C7" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ViewGrid" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Đổi góc nhìn" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1">

                                <!-- 1. GIAO DIỆN GRID (Ô VUÔNG) -->
                                <ListBox ItemsSource="{Binding AvailableSoftwaresView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource SharedGroupItemStyle}"/>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#333333" CornerRadius="8" Padding="15" Margin="6" Width="140" Height="185" BorderBrush="#3E3E3E" BorderThickness="1">
                                                <StackPanel>
                                                    <Image Source="{Binding IconPath, Converter={StaticResource ImgConverter}}" Width="48" Height="48" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap" Height="40" FontSize="13"/>
                                                    <Button Command="{Binding DataContext.AddSoftwareCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource FluentButtonStyle}" 
                                                            Background="#16A34A" Padding="8,8" Margin="0,8,0,0" Content="Thêm"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 2. GIAO DIỆN LIST (DATAGRID) -->
                                <DataGrid ItemsSource="{Binding AvailableSoftwaresView}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                          Foreground="#FFFFFF" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" RowHeight="48">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource SharedGroupItemStyle}"/>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="Padding" Value="10,0,10,12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#333333"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.AddSoftwareCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Style="{StaticResource FluentButtonStyle}" Background="#16A34A" Padding="16,8"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Thêm" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Icon" Width="60" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding IconPath, Converter={StaticResource ImgConverter}}" Width="28" Height="28" Stretch="Uniform"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Tên phần mềm" Binding="{Binding Name}" Width="2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="1.5*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Nhà phát triển" Binding="{Binding Publisher}" Width="1.5*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: GIỎ HÀNG -->
                    <Border Grid.Column="2" Background="#282828" CornerRadius="8" Padding="20" BorderBrush="#0284C7" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Đã Thêm Vào Gói" Foreground="#60CDFF" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"/>
                                <TextBlock Text="Chọn phiên bản cụ thể cho từng phần mềm" Foreground="#AAAAAA" FontSize="13"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSoftwares}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      Foreground="#FFFFFF" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                                      RowHeight="52" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="Padding" Value="8,0,8,10"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#1C2A1D"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#23342A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <!-- Icon phần mềm -->
                                    <DataGridTemplateColumn Header="" Width="42" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding IconPath, Converter={StaticResource ImgConverter}}" Width="26" Height="26" Stretch="Uniform"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Tên phần mềm -->
                                    <DataGridTextColumn Header="Tên phần mềm" Binding="{Binding Name}" Width="1.6*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Combobox chọn phiên bản -->
                                    <DataGridTemplateColumn Header="Phiên bản" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Versions}"
                                                          DisplayMemberPath="Version"
                                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                          SelectedIndex="0"
                                                          Loaded="VersionComboBox_Loaded"
                                                          Style="{StaticResource FluentComboBoxStyle}"
                                                          Height="30"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Dung lượng của phiên bản đang chọn -->
                                    <DataGridTextColumn Header="Dung lượng" Binding="{Binding SelectedVersion.Size, FallbackValue='—'}" Width="0.9*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FCE100"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="TextAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Nút xóa khỏi gói -->
                                    <DataGridTemplateColumn Header="" Width="38" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveSoftwareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Background="Transparent" Foreground="#F44336" BorderThickness="0" Cursor="Hand"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4">
                                                    <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Hủy Bỏ" Style="{StaticResource FluentButtonStyle}" Background="#333333" Padding="24,12" Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button Style="{StaticResource FluentButtonStyle}" Background="#D97706" Padding="32,12" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LƯU GÓI PRESET" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>