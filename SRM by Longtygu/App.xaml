<Application x:Class="SRM_by_Longtygu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:SRM_by_Longtygu.ViewModels"
             xmlns:views="clr-namespace:SRM_by_Longtygu.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeploymentViewModel}">
            <views:DeploymentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UninstallViewModel}">
            <views:UninstallView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PresetMainViewModel}">
            <views:PresetMainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ResourceFileMainViewModel}">
            <views:ResourceFileMainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>

        <!-- MỚI: Trang riêng "Trung tâm cập nhật" -->
        <DataTemplate DataType="{x:Type viewmodels:UpdateCenterViewModel}">
            <views:UpdateCenterView />
        </DataTemplate>
    </Application.Resources>
</Application>
