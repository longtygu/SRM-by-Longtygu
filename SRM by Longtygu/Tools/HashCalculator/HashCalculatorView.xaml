<UserControl x:Class="SRM_by_Longtygu.Tools.HashCalculator.HashCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
             AllowDrop="True"
             DragOver="RootGrid_DragOver"
             Drop="RootGrid_Drop">

    <UserControl.Resources>

        <!-- ============ PROGRESS BAR BO TRÒN KIỂU FLUENT ============ -->
        <ControlTemplate x:Key="FluentProgressBarTemplate" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                        HorizontalAlignment="Left"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="FluentProgressBar" TargetType="ProgressBar">
            <Setter Property="Template" Value="{StaticResource FluentProgressBarTemplate}"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#60CDFF"/>
        </Style>

        <!-- ============ NÚT CHÍNH (ACCENT) ============ -->
        <Style x:Key="FluentAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#60CDFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#7ED6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4BB8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NÚT NGUY HIỂM (HỦY) ============ -->
        <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentAccentButton}">
            <Setter Property="Background" Value="#E06C75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8858D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C85A63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NÚT GHOST (TRONG SUỐT — Copy / Xóa / Xóa tất cả) ============ -->
        <Style x:Key="FluentGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60CDFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ CARD KIỂU "MICA" ============ -->
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- ============ ICON BADGE TRÒN ============ -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#1A60CDFF"/>
        </Style>

        <!-- ============ THANH CUỘN TỐI MÀU (áp dụng ngầm cho mọi ScrollViewer trong view) ============ -->
        <Style x:Key="FluentScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A4A4A" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TIÊU ĐỀ ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Hash Calculator" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#60CDFF" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ============ CARD: ĐỐI CHIẾU HASH ============ -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <iconPacks:PackIconMaterial Kind="CompareHorizontal" Width="15" Height="15"
                                                 Foreground="#60CDFF" VerticalAlignment="Center"/>
                    <TextBlock Text="Đối chiếu hash" FontSize="13.5" FontWeight="SemiBold" Foreground="White"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="#2E2E2E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6">
                    <TextBox Text="{Binding CompareHash, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             Padding="10,9" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             CaretBrush="White"/>
                </Border>

                <TextBlock Text="Dán hash (MD5 / SHA1 / SHA256 / SHA512 / CRC32) cần kiểm tra vào đây — hệ thống tự so khớp với từng file bên dưới."
                           FontSize="10.5" Foreground="#6E6E6E" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ============ NỘI DUNG CHÍNH: KÉO THẢ + DANH SÁCH KẾT QUẢ ============ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== THANH KÉO THẢ / CHỌN FILE ===== -->
            <Border Grid.Row="0" Style="{StaticResource FluentCard}" Padding="18,16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadge}">
                            <iconPacks:PackIconMaterial Kind="TrayArrowDown" Width="17" Height="17"
                                                         Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Kéo thả file vào đây để tính hash" FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Thả nhiều file cùng lúc — file được đọc trực tiếp từ vị trí gốc, không sao chép vào máy."
                                       FontSize="11" Foreground="#909090" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Items.Count, StringFormat={}{0} file}" FontSize="12"
                               Foreground="#909090" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Button Grid.Column="2" Content="Xóa tất cả" Command="{Binding ClearAllCommand}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FluentGhostButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ===== Nút Chọn file (ẩn khi đang xử lý hàng đợi) ===== -->
                    <Button Grid.Column="3" Content="Chọn file..." Command="{Binding BrowseFilesCommand}"
                            Width="130">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FluentAccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ===== Nút Hủy (chỉ hiện khi đang xử lý hàng đợi) ===== -->
                    <Button Grid.Column="3" Content="Hủy" Command="{Binding CancelCommand}"
                            Width="90">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FluentDangerButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessingQueue}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== DANH SÁCH KẾT QUẢ ===== -->
            <Grid Grid.Row="1">
                <!-- Trạng thái rỗng -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <iconPacks:PackIconMaterial Kind="FileSearchOutline" Width="40" Height="40" Foreground="#3A3A3A"
                                                 HorizontalAlignment="Center"/>
                    <TextBlock Text="Chưa có file nào — kéo thả hoặc bấm &quot;Chọn file...&quot; để bắt đầu"
                               FontSize="12.5" Foreground="#6E6E6E" Margin="0,10,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#232323" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>

                                        <!-- ===== Header: icon + tên file + dung lượng + badge khớp + xóa ===== -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                    Background="#1A60CDFF" Margin="0,0,12,0">
                                                <iconPacks:PackIconMaterial Kind="FileOutline" Width="18" Height="18"
                                                                             Foreground="#60CDFF"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#909090" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Badge khớp / không khớp -->
                                            <Border Grid.Column="2" CornerRadius="20" Padding="9,4" Margin="0,0,10,0"
                                                    VerticalAlignment="Center" Background="{Binding MatchChipBackground}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMatchResult}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="{Binding MatchIconKind}" Width="12" Height="12"
                                                                                 Foreground="{Binding MatchColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MatchLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding MatchColor}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Column="3" Content="✕"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FluentGhostButton}" Padding="8,4"/>
                                        </Grid>

                                        <!-- ===== Đang xử lý: progress bar ===== -->
                                        <StackPanel Margin="0,0,0,10">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Đang tính hash..." FontSize="11.5" Foreground="#909090"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                                           FontSize="11.5" Foreground="#60CDFF"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                                         Style="{StaticResource FluentProgressBar}"/>
                                        </StackPanel>

                                        <!-- ===== Lỗi ===== -->
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E06C75" FontSize="11.5"
                                                   Margin="0,0,0,8" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ===== 5 dòng hash (chỉ hiện khi tính xong, không lỗi) ===== -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- MD5 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MD5" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Md5, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Foreground="#D0D0D0"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,6"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Copy"
                                                        Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Md5}"
                                                        Style="{StaticResource FluentGhostButton}" Padding="8,4" FontSize="10.5"/>
                                            </Grid>

                                            <!-- SHA1 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SHA1" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Sha1, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Foreground="#D0D0D0"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,6"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Copy"
                                                        Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Sha1}"
                                                        Style="{StaticResource FluentGhostButton}" Padding="8,4" FontSize="10.5"/>
                                            </Grid>

                                            <!-- SHA256 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SHA256" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Sha256, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Foreground="#D0D0D0"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,6"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Copy"
                                                        Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Sha256}"
                                                        Style="{StaticResource FluentGhostButton}" Padding="8,4" FontSize="10.5"/>
                                            </Grid>

                                            <!-- SHA512 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SHA512" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Sha512, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Foreground="#D0D0D0"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,6"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Copy"
                                                        Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Sha512}"
                                                        Style="{StaticResource FluentGhostButton}" Padding="8,4" FontSize="10.5"/>
                                            </Grid>

                                            <!-- CRC32 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CRC32" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#161616" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding Crc32, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Foreground="#D0D0D0"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="8,6"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Copy"
                                                        Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Crc32}"
                                                        Style="{StaticResource FluentGhostButton}" Padding="8,4" FontSize="10.5"/>
                                            </Grid>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
