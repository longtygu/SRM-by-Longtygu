<UserControl x:Class="SRM_by_Longtygu.Views.DeploymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:helpers="clr-namespace:SRM_by_Longtygu.Helpers"
             Background="Transparent" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <UserControl.Resources>
        <helpers:ImagePathConverter x:Key="ImgConverter"/>

        <!-- ĐỒNG BỘ MÀU THEME XANH NAVY DỊU MẮT -->
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#2A4B6E"/>

        <!-- STYLE THANH CUỘN (SCROLLBAR) TÀNG HÌNH -->
        <Style x:Key="DarkThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHECKBOX VUÔNG BO GÓC CHUẨN WINDOWS 11 -->
        <Style TargetType="CheckBox" x:Key="FluentGridCheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A" Background="#282828">
                            <iconPacks:PackIconMaterial x:Name="CheckIcon" Kind="Check" Foreground="#000000" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#60CDFF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60CDFF"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsDeploying, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX DARK MODE -->
        <Style TargetType="ComboBox" x:Key="DarkComboBoxStyle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconMaterial Grid.Column="1" Kind="ChevronDown" Width="11" Height="11"
                                                                             Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#3E3E3E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="True">
                                    <Border Background="#2D2D2D" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="12" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#60CDFF"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1: Thanh tìm kiếm -->
            <RowDefinition Height="*"/>
            <!-- Dòng 2: Nội dung chính -->
        </Grid.RowDefinitions>

        <!-- DÒNG 0: TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="CÀI ĐẶT THEO LỰA CHỌN" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,24"/>

        <!-- DÒNG 1: THANH TÌM KIẾM -->
        <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6" Padding="12,8" Margin="0,0,0,24" BorderBrush="#454545" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Kind="Magnify" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" CaretBrush="#FFFFFF"
                         VerticalContentAlignment="Center" FontSize="14"/>

                <TextBlock Grid.Column="1" Text="Nhập tên phần mềm, nhà phát triển hoặc danh mục để tìm kiếm..." 
                           Foreground="#888888" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox, FallbackValue=0}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- DÒNG 2: BỐ CỤC CHÍNH ĐÃ CHIA CỘT (Điều chỉnh 75:25) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <!-- Mở rộng DataGrid thêm 15% -->
                <ColumnDefinition Width="2.5*"/>
                <!-- Thu hẹp khu vực Control & Log 15% -->
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH BỘ CÀI -->
            <Border Grid.Column="0" Background="#282828" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Padding="10" Margin="0,0,24,0">
                <DataGrid ItemsSource="{Binding QueueView}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          Foreground="#FFFFFF" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0" Sorting="DataGrid_Sorting" RowHeight="48">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Padding" Value="15,0,15,10"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="10,0,10,4"/>
                            <!-- Bo góc nhẹ cho dòng nếu cần, nhưng WPF DataGridRow mặc định ko support CornerRadius trực tiếp -->

                            <Style.Triggers>
                                <!-- TRIGGER ĐỔI MÀU NỀN DÒNG THEO TRẠNG THÁI -->
                                <DataTrigger Binding="{Binding Status}" Value="Thành công">
                                    <Setter Property="Background" Value="#173B1F"/>
                                    <!-- Xanh lá đậm mờ -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Lỗi">
                                    <Setter Property="Background" Value="#4A1D23"/>
                                    <!-- Đỏ đậm mờ -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Đang xử lý...">
                                    <Setter Property="Background" Value="#4A4315"/>
                                    <!-- Vàng sẫm mờ -->
                                </DataTrigger>

                                <!-- Trigger Hover & Select đặt bên dưới để người dùng khi thao tác vẫn thấy nổi bật -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <!-- Expander Group Style -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Background="#282828" BorderThickness="0,0,0,1" BorderBrush="#333333" Margin="0,10">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" Margin="5,10">
                                                            <iconPacks:PackIconMaterial Kind="FolderOpen" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} app)'}" Foreground="#888888" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="15,0,0,0"/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <!-- CỘT DATAGRID (ĐÃ XÓA CỘT TRẠNG THÁI) -->
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <iconPacks:PackIconMaterial Kind="CheckAll" Foreground="#60CDFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentGridCheckBox}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="32" Height="32">
                                        <Border Background="#333333" CornerRadius="6"/>
                                        <iconPacks:PackIconMaterial Kind="Application" Foreground="#555555" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Software.IconPath, Converter={StaticResource ImgConverter}}" Stretch="Uniform" Margin="4"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tên phần mềm" Binding="{Binding Software.Name}" Width="1.5*" IsReadOnly="True" FontWeight="SemiBold"/>

                        <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <iconPacks:PackIconMaterial Kind="Paperclip" Foreground="#666666" Width="14" Height="14" ToolTip="Có tài nguyên đính kèm"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <iconPacks:PackIconMaterial Kind="Paperclip" Foreground="#60CDFF" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial.Style>
                                            <Style TargetType="iconPacks:PackIconMaterial">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="ToolTip" Value="{Binding AttachedResourceCount, StringFormat='{}{0} tài nguyên đính kèm'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAttachedResources}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconMaterial.Style>
                                    </iconPacks:PackIconMaterial>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Phiên bản cài đặt" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                                              SelectedItem="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource DarkComboBoxStyle}" Width="130" Height="32" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Version}" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="4"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Software.Category}" Width="1.5*" IsReadOnly="True" Foreground="#CCCCCC"/>

                        <DataGridTextColumn Header="Nhà phát triển" Binding="{Binding Software.Publisher}" Width="1.5*" IsReadOnly="True" Foreground="#CCCCCC"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- CỘT PHẢI: CONTROLS & LOGS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Nút & Checkbox -->
                    <RowDefinition Height="*"/>
                    <!-- Log lấp đầy bên dưới -->
                </Grid.RowDefinitions>

                <!-- KHUNG ĐIỀU KHIỂN -->
                <Border Grid.Row="0" Background="#282828" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel VerticalAlignment="Center">

                        <Button Command="{Binding StartDeployCommand}" x:Name="DeployButton" Padding="12" Cursor="Hand" Margin="0,0,0,15">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#16A34A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                                        <Setter Property="Foreground" Value="#8A8A8A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="RocketLaunch" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center">
                                    <Run Text="TIẾN HÀNH CÀI ĐẶT ("/>
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/> 
                                    <Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Border Background="#2D2D2D" CornerRadius="6" Padding="12" Margin="0,0,0,15" BorderBrush="#3E3E3E" BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsCustomPathEnabled}" Cursor="Hand">
                                    <TextBlock Text="Cài Portable sang phân vùng khác" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="12" Margin="5,0,0,0" TextWrapping="Wrap"/>
                                </CheckBox>

                                <Grid Margin="0,12,0,0" IsEnabled="{Binding IsCustomPathEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CustomInstallPath, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#202020" Foreground="#6CCB5F" FontFamily="Consolas" FontSize="12"
                                             Padding="8,6" BorderBrush="#454545" BorderThickness="1" IsReadOnly="True" VerticalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <Button Grid.Column="1" Command="{Binding SelectInstallFolderCommand}" Background="#333333" Foreground="#FFFFFF" BorderThickness="0" Padding="10,0" Margin="8,0,0,0" Cursor="Hand" ToolTip="Chọn thư mục">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                        <iconPacks:PackIconMaterial Kind="FolderOpen" VerticalAlignment="Center" Width="14" Height="14"/>
                                    </Button>
                                </Grid>

                                <Border Height="1" Background="#3E3E3E" Margin="0,12,0,12"/>

                                <CheckBox IsChecked="{Binding OpenResourceAfterInstall}" Cursor="Hand"
                                          ToolTip="Mở Explorer tới vị trí các tài nguyên đính kèm">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Paperclip" Foreground="#60CDFF" Width="12" Height="12" VerticalAlignment="Center" Margin="5,0,6,0"/>
                                        <TextBlock Text="Mở tài nguyên khi cài xong" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding GlobalStatus}" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Border CornerRadius="4" ClipToBounds="True" Height="8" Background="#333333">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Background="Transparent" Foreground="#60CDFF" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- KHUNG TERMINAL LOG -->
                <Border Grid.Row="1" Background="#121212" CornerRadius="8" Padding="12" BorderBrush="#333333" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                            <iconPacks:PackIconMaterial Kind="ConsoleLine" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                            <TextBlock Text="Deployment Logs" Foreground="#888888" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding LiveLogs}" Background="Transparent" BorderThickness="0" Foreground="#6CCB5F" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>