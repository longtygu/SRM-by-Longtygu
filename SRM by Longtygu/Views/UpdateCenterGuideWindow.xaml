<Window x:Class="SRM_by_Longtygu.Views.UpdateCenterGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{DynamicResource UpdateCenterGuide_UpdateCenterGuide}" Height="700" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#555555" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#60CDFF"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="BodyTextStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style TargetType="Border" x:Key="SourceCardStyle">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="#202020" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconMaterial Kind="HelpCircleOutline" Foreground="#60CDFF" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource UpdateCenterGuide_UpdateCenterUserGuide}" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="45" Click="CloseButton_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24,0,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_ThisPageHelpsYou}" Style="{StaticResource BodyTextStyle}" Margin="0,16,0,0"/>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_1ThreeTypesOf}" Style="{StaticResource SectionTitleStyle}"/>

                        <Border Style="{StaticResource SourceCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <iconPacks:PackIconMaterial Kind="Star" Width="14" Height="14" Foreground="#FCD34D" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource UpdateCenterGuide_WingetRecommendedFirst}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_UsesTheReadyMade}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SourceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="GitHub Releases" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_ForOpenSourceSoftware}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SourceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UpdateCenterGuide_WebPageScanRegex}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_ALastResortWhen}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_2AutoConfigureNo}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}">
                            <Run Text="{DynamicResource UpdateCenterGuide_The}"/><Run FontWeight="Bold" Foreground="#FFFFFF" Text="{DynamicResource UpdateCenterGuide_AutoConfigure}"/><Run Text="{DynamicResource UpdateCenterGuide_ButtonOnTheToolbar}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_3RowActionButtons}" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="#AAAAAA" Margin="0,2,10,0"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_ConfigureTheUpdateCheck}" Width="440"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Foreground="#AAAAAA" Margin="0,2,10,0"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_ScanThisSoftwareRight}" Width="440"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="TrayArrowDown" Width="16" Height="16" Foreground="#0284C7" Margin="0,2,10,0"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Width="440">
                                    <Run FontWeight="Bold" Foreground="#FFFFFF" Text="{DynamicResource UpdateCenterGuide_Download}"/><Run Text="{DynamicResource UpdateCenterGuide_DownloadsTheNewVersion}"/><Run FontWeight="Bold" Text="{DynamicResource UpdateCenterGuide_AddsItToThe}"/><Run Text="{DynamicResource UpdateCenterGuide_DataFolderDBWITHOUT}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Rocket" Width="16" Height="16" Foreground="#16A34A" Margin="0,2,10,0"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Width="440">
                                    <Run FontWeight="Bold" Foreground="#FFFFFF" Text="{DynamicResource UpdateCenterGuide_InstallNow}"/><Run Text="{DynamicResource UpdateCenterGuide_DownloadsTheNewVersion2}"/><Run FontWeight="Bold" Text="{DynamicResource UpdateCenterGuide_InstallsItOnThis}"/><Run Text="{DynamicResource UpdateCenterGuide_WithAWingetSource}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_4FilteringAndGrouping}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_UseTheChipsAll}"/>

                        <TextBlock Text="{DynamicResource UpdateCenterGuide_5NotesWhenUsing}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{DynamicResource UpdateCenterGuide_TheAppItselfDoes}"/>

                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1" Click="CloseButton_Click" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                        Padding="0,12" Margin="0,16,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <TextBlock Text="{DynamicResource UpdateCenterGuide_GotIt}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
