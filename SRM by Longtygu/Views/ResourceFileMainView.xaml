<UserControl x:Class="SRM_by_Longtygu.Views.ResourceFileMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:helpers="clr-namespace:SRM_by_Longtygu.Helpers"
             Background="Transparent" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <UserControl.Resources>
        <helpers:ImagePathConverter x:Key="ImgConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:CustomOrAutoIconConverter x:Key="AutoIconConverter"/>

        <!-- Ghi đè màu hệ thống dùng bởi DataGridCell khi selection, để đồng bộ theme tối -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0284C7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#282828"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#282828"/>

        <Style TargetType="Button" x:Key="FluentButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MiniIconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE CHO DATAGRID (THEME TỐI FLUENT) ==================== -->

        <Style TargetType="DataGridColumnHeader" x:Key="FluentColumnHeaderStyle">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow" x:Key="FluentRowStyle">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#282828"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" x:Key="FluentCellStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid" x:Key="FluentDataGridStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource FluentRowStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource FluentCellStyle}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ColNameStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ColCategoryStyle">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ColSizeStyle">
            <Setter Property="Foreground" Value="#FCE100"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Thư viện Tài nguyên (ISO / DLL / Configs)" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding AddResourceCommand}" Style="{StaticResource FluentButtonStyle}" Background="#16A34A" Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18"/>
                    <TextBlock Text="Thêm File Mới" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="#333333" CornerRadius="6" Padding="15,10" BorderBrush="#454545" BorderThickness="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconMaterial Grid.Column="0" Kind="Magnify" Foreground="#CCCCCC" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="15"/>
            </Grid>
        </Border>

        <!-- ==================== KHU VỰC CHÍNH: DATAGRID (TRÁI) + CHI TIẾT (PHẢI) ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid danh sách tài nguyên -->
            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" BorderBrush="#3E3E3E" BorderThickness="1">
                <DataGrid Style="{StaticResource FluentDataGridStyle}"
                          ItemsSource="{Binding ResourceFilesView}"
                          SelectedItem="{Binding SelectedResource, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!-- Cột icon -->
                        <DataGridTemplateColumn Header="" Width="66" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="38" Height="38">
                                        <iconPacks:PackIconMaterial Kind="FileCabinet" Foreground="#60CDFF" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}">
                                            <Image Stretch="Uniform">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource AutoIconConverter}">
                                                        <Binding Path="IconPath"/>
                                                        <Binding Path="FolderPath"/>
                                                        <Binding Path="FileName"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột Tên tài nguyên -->
                        <DataGridTextColumn Header="Tên tài nguyên" Binding="{Binding Name}" Width="3*" ElementStyle="{StaticResource ColNameStyle}"/>

                        <!-- Cột Loại -->
                        <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="2*" ElementStyle="{StaticResource ColCategoryStyle}"/>

                        <!-- Cột Dung lượng -->
                        <DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="1.2*" ElementStyle="{StaticResource ColSizeStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Panel chi tiết bên phải -->
            <Border Grid.Column="2" Background="#282828" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="24">
                <Grid>
                    <!-- Trạng thái: chưa chọn item nào -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding SelectedResource, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <iconPacks:PackIconMaterial Kind="CursorDefaultClick" Width="40" Height="40" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Chọn một tài nguyên để xem chi tiết" Foreground="#888888" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                    </StackPanel>

                    <!-- Trạng thái: đã chọn item -->
                    <Grid Visibility="{Binding SelectedResource, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon + Tên + Loại -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Grid Width="52" Height="52" Margin="0,0,14,0">
                                <Border Background="#1E1E1E" CornerRadius="8">
                                    <iconPacks:PackIconMaterial Kind="FileCabinet" Foreground="#60CDFF" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#1E1E1E" CornerRadius="8">
                                    <Image Stretch="Uniform" Margin="6">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource AutoIconConverter}">
                                                <Binding Path="SelectedResource.IconPath"/>
                                                <Binding Path="SelectedResource.FolderPath"/>
                                                <Binding Path="SelectedResource.FileName"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedResource.Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" MaxWidth="260"/>
                                <TextBlock Text="{Binding SelectedResource.Category}" FontSize="13" Foreground="#60CDFF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dải thông tin nhanh -->
                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dung lượng" Foreground="#888888" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResource.Size}" Foreground="#FCE100" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tên file" Foreground="#888888" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResource.FileName}" Foreground="#DDDDDD" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="20,0,0,0"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngày thêm" Foreground="#888888" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResource.AddedDate, StringFormat=dd/MM/yyyy}" Foreground="#DDDDDD" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mô tả -->
                        <TextBlock Grid.Row="2" Text="Mô tả / Ghi chú:" Foreground="#888888" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="3" Text="{Binding SelectedResource.Description}" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#333333" BorderThickness="1"
                                 Padding="14" Margin="0,0,0,16" FontSize="13" SelectionBrush="#0284C7"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Nút thao tác -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <Button Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedResource.FolderPath}" Style="{StaticResource FluentButtonStyle}" Background="#0284C7" Padding="16,10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                    <TextBlock Text="Mở Thư Mục" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding EditResourceCommand}" CommandParameter="{Binding SelectedResource}" Style="{StaticResource MiniIconButtonStyle}" Foreground="#888888" Padding="10" Margin="0,0,6,0" ToolTip="Chỉnh sửa">
                                <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18"/>
                            </Button>

                            <Button Command="{Binding DeleteResourceCommand}" CommandParameter="{Binding SelectedResource}" Style="{StaticResource MiniIconButtonStyle}" Foreground="#C42B1C" Padding="10" ToolTip="Xóa khỏi thư viện">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
