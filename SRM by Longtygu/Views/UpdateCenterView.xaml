<UserControl x:Class="SRM_by_Longtygu.Views.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:SRM_by_Longtygu.Converters"
             Background="Transparent" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:IconPathToImageSourceConverter x:Key="IconConverter"/>
        <converters:ProgressPercentToWidthConverter x:Key="ProgressWidthConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:NonNegativeToVisibilityConverter x:Key="NonNegativeToVisConverter"/>
        <converters:NegativeToVisibilityConverter x:Key="NegativeToVisConverter"/>

        <!-- STYLE THANH CUỘN -->
        <Style x:Key="DarkThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT ACTION CHUẨN FLUENT -->
        <Style TargetType="Button" x:Key="FluentActionButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT LỌC NHANH (pill / chip) -->
        <Style TargetType="RadioButton" x:Key="FilterChipStyle">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" Background="#2D2D2D" CornerRadius="20" BorderBrush="#454545" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#2A4B6E"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#60CDFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHECKBOX KIỂU TOGGLE NHỎ GỌN CHO "Nhóm theo danh mục" -->
        <Style TargetType="CheckBox" x:Key="ToggleCheckStyle">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- THẺ THỐNG KÊ -->
        <Style TargetType="Border" x:Key="StatCardStyle">
            <Setter Property="Background" Value="#282828"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <!-- Badge "Chưa cấu hình" - Ẩn khi HasUpdateSourceConfigured = True -->
        <Style TargetType="Border" x:Key="NotConfiguredBadgeStyle">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpdateSourceConfigured}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- MỚI: Style riêng cho 4 nút thao tác trên từng dòng (Cấu hình/Quét/Tải về/Cài ngay).
             BẮT BUỘC phải có ControlTemplate riêng - nếu chỉ set Background/Foreground như trước,
             lúc IsEnabled=False WPF sẽ tự đổi sang bảng màu "disabled" mặc định của theme hệ thống
             (thường là nền xám nhạt gần trắng + chữ xám nhạt gần trắng) và BỎ QUA hoàn toàn Background/
             Foreground mình đã set -> đúng hiện tượng "chữ trắng nền trắng" khi nút bị disable lúc đang tải.
             Cách này giữ nguyên màu thương hiệu, chỉ giảm độ mờ (Opacity) khi disable, không đổi màu. -->
        <Style TargetType="Button" x:Key="RowActionButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HÀNG 1: TIÊU ĐỀ + NÚT HƯỚNG DẪN / TỰ ĐỘNG CẤU HÌNH / QUÉT TẤT CẢ ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="CloudSyncOutline" Width="28" Height="28" Foreground="#7C3AED" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="TRUNG TÂM CẬP NHẬT" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding LastScanDisplayText}" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- MỚI: Nút hướng dẫn - luôn có thể bấm lại xem bất cứ lúc nào -->
                <Button Command="{Binding ShowGuideCommand}" Background="#333333" BorderThickness="0" Cursor="Hand"
                        Width="42" Height="42" Margin="0,0,10,0" ToolTip="Xem hướng dẫn sử dụng">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="21"/></Style>
                    </Button.Resources>
                    <iconPacks:PackIconMaterial Kind="HelpCircleOutline" Width="20" Height="20" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- MỚI: Tự động áp catalog gợi ý cho toàn bộ phần mềm chưa cấu hình, đỡ phải setup tay từng cái -->
                <Button Command="{Binding AutoConfigureAllCommand}" Style="{StaticResource FluentActionButton}"
                        Background="#0284C7" VerticalAlignment="Center" Padding="16,12"
                        ToolTip="Tự động dò và áp cấu hình gợi ý sẵn cho toàn bộ phần mềm chưa cấu hình">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AutoFix" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="Tự động cấu hình" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- MỚI: Tải toàn bộ bản cập nhật đang có về thư viện cùng lúc -->
                <Button Command="{Binding UpdateAllCommand}" Style="{StaticResource FluentActionButton}"
                        Background="#0284C7" VerticalAlignment="Center" Padding="18,12" Margin="10,0,0,0"
                        ToolTip="Tải tất cả bản cập nhật đang có về thư viện (Data/), không đụng gì tới máy này">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="TrayArrowDown" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock FontWeight="SemiBold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Cập nhật toàn bộ"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdatingAll}" Value="True">
                                            <Setter Property="Text" Value="{Binding UpdateAllStatusText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CheckAllUpdatesCommand}" Style="{StaticResource FluentActionButton}"
                        Background="#7C3AED" VerticalAlignment="Center" Padding="18,12" Margin="10,0,0,0" ToolTip="Quét toàn bộ phần mềm đã cấu hình nguồn cập nhật">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Radar" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock FontWeight="SemiBold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Quét toàn bộ"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCheckingUpdates}" Value="True">
                                            <Setter Property="Text" Value="{Binding UpdateCheckProgress, StringFormat='Đang quét... {0}%'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== HÀNG 2: THẺ THỐNG KÊ NHANH ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalSoftwareCount}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Tổng phần mềm" Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ConfiguredCount}" FontSize="26" FontWeight="Bold" Foreground="#60CDFF"/>
                    <TextBlock Text="Đã cấu hình nguồn" Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding UpdateAvailableCount}" FontSize="26" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="Có bản cập nhật" Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding NotConfiguredCount}" FontSize="26" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Text="Chưa cấu hình" Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== HÀNG 3: TÌM KIẾM + BỘ LỌC NHANH + TOGGLE NHÓM DANH MỤC ===== -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton GroupName="FilterGroup" Style="{StaticResource FilterChipStyle}" IsChecked="True"
                             Command="{Binding SetFilterCommand}" CommandParameter="All" Content="Tất cả"/>
                <RadioButton GroupName="FilterGroup" Style="{StaticResource FilterChipStyle}"
                             Command="{Binding SetFilterCommand}" CommandParameter="UpdateAvailable" Content="Có bản mới"/>
                <RadioButton GroupName="FilterGroup" Style="{StaticResource FilterChipStyle}"
                             Command="{Binding SetFilterCommand}" CommandParameter="Configured" Content="Đã cấu hình"/>
                <RadioButton GroupName="FilterGroup" Style="{StaticResource FilterChipStyle}"
                             Command="{Binding SetFilterCommand}" CommandParameter="NotConfigured" Content="Chưa cấu hình"/>
            </StackPanel>

            <!-- MỚI: Bật/tắt nhóm theo danh mục -->
            <CheckBox Grid.Column="2" Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding GroupByCategory}"
                      Content="Nhóm theo danh mục" Margin="0,0,16,0" VerticalAlignment="Center"/>

            <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="6" BorderBrush="#454545" BorderThickness="1"
                    Padding="12,8" HorizontalAlignment="Right" Width="300" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Magnify" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                             VerticalAlignment="Center" FontSize="13" CaretBrush="#FFFFFF" Width="250"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== HÀNG 4: HEADER CỘT (cố định, để bảng nhìn có trật tự) + DANH SÁCH ===== -->
        <Grid Grid.Row="3" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header cột -->
            <Border Grid.Row="0" Background="#242424" CornerRadius="8,8,0,0" BorderBrush="#333333" BorderThickness="1,1,1,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" SharedSizeGroup="colIcon"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="2.2*" SharedSizeGroup="colName"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.2*" SharedSizeGroup="colVersion"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.4*" SharedSizeGroup="colStatus"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="colActions"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="PHẦN MỀM" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                    <Border Grid.Column="3" Width="1" Background="#3A3A3A"/>
                    <TextBlock Grid.Column="4" Text="PHIÊN BẢN" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                    <Border Grid.Column="5" Width="1" Background="#3A3A3A"/>
                    <TextBlock Grid.Column="6" Text="TRẠNG THÁI CẬP NHẬT" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                    <Border Grid.Column="7" Width="1" Background="#3A3A3A"/>
                    <TextBlock Grid.Column="8" Text="THAO TÁC" FontSize="11" FontWeight="Bold" Foreground="#777777" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- Danh sách -->
            <Border Grid.Row="1" Background="#282828" CornerRadius="0,0,8,8" BorderBrush="#333333" BorderThickness="1,0,1,1" Padding="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SoftwareView}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#333333" CornerRadius="6" Padding="12,7" Margin="4,10,4,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="FolderOutline" Width="15" Height="15" Foreground="#60CDFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="4,3" Padding="16,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" SharedSizeGroup="colIcon"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="2.2*" SharedSizeGroup="colName"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="1.2*" SharedSizeGroup="colVersion"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="1.4*" SharedSizeGroup="colStatus"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="colActions"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Đường phân cách cột - giúp bảng nhìn tách bạch rõ ràng hơn -->
                                            <Border Grid.Column="3" Width="1" Background="#2E2E2E" Margin="0,-12"/>
                                            <Border Grid.Column="5" Width="1" Background="#2E2E2E" Margin="0,-12"/>
                                            <Border Grid.Column="7" Width="1" Background="#2E2E2E" Margin="0,-12"/>

                                            <!-- Icon thật từ IconPath, có nền placeholder phía sau nếu chưa có/không đọc được icon -->
                                            <Border Grid.Column="0" Width="36" Height="36" Background="#333333" CornerRadius="6">
                                                <Grid>
                                                    <iconPacks:PackIconMaterial Kind="Application" Foreground="#666666" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                                           Width="36" Height="36" Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,36,36" RadiusX="6" RadiusY="6"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <!-- Tên + nhà phát hành -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Phiên bản hiện có -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Versions.Count, StringFormat='{}{0} phiên bản'}" FontSize="13" Foreground="#CCCCCC" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- Trạng thái cập nhật -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                <Border Style="{StaticResource NotConfiguredBadgeStyle}" Background="#333333" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="Chưa cấu hình" FontSize="11" Foreground="#999999" FontWeight="SemiBold"/>
                                                </Border>

                                                <StackPanel Visibility="{Binding HasUpdateSourceConfigured, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="#16A34A" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconMaterial Kind="ArrowUpBoldCircleOutline" Width="12" Height="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding LatestKnownVersion, StringFormat='Có bản {0}'}" FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding LastCheckedDisplay}" FontSize="11" Foreground="#666666"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Nút thao tác -->
                                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.ConfigureUpdateSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource RowActionButtonStyle}"
                                                        Background="Transparent" Padding="8" ToolTip="Cấu hình nguồn kiểm tra cập nhật" Margin="0,0,4,0"
                                                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolConverter}}">
                                                    <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="#AAAAAA"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.CheckOneUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource RowActionButtonStyle}"
                                                        Background="#333333" Padding="10,7" Margin="0,0,6,0" ToolTip="Quét riêng phần mềm này"
                                                        Visibility="{Binding HasUpdateSourceConfigured, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolConverter}}">
                                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DownloadUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource RowActionButtonStyle}"
                                                        Background="#0284C7" Padding="10,7" Margin="0,0,6,0" ToolTip="Tải bản mới về và thêm vào thư viện (không cài lên máy)"
                                                        Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="TrayArrowDown" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Tải về" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding DataContext.InstallUpdateNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource RowActionButtonStyle}"
                                                        Background="#16A34A" Padding="10,7" ToolTip="Tải bản mới, thêm vào thư viện, rồi cài luôn lên máy này"
                                                        Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="Rocket" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Cài ngay" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            </Grid>

                                            <!-- MỚI: Thanh tiến trình tải - chỉ hiện khi đang tải phần mềm này -->
                                            <Grid Grid.Row="1" Margin="50,10,0,0"
                                                  Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Trường hợp có % thật (tải qua HTTP: GitHub/Regex) -->
                                                    <Grid x:Name="ProgressTrack" Grid.Column="0" Height="6" VerticalAlignment="Center" ClipToBounds="True"
                                                          Visibility="{Binding DownloadProgressPercent, Converter={StaticResource NonNegativeToVisConverter}}">
                                                        <Border Background="#333333" CornerRadius="3"/>
                                                        <Border Background="#0284C7" CornerRadius="3" HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                                    <Binding Path="DownloadProgressPercent"/>
                                                                    <Binding ElementName="ProgressTrack" Path="ActualWidth"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Trường hợp không có % thật (VD: cài qua Winget) - hiện icon xoay -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding DownloadProgressPercent, Converter={StaticResource NegativeToVisConverter}}">
                                                        <iconPacks:PackIconMaterial Kind="Autorenew" Width="14" Height="14" Foreground="#0284C7" Margin="0,0,8,0">
                                                            <iconPacks:PackIconMaterial.RenderTransform>
                                                                <RotateTransform CenterX="7" CenterY="7"/>
                                                            </iconPacks:PackIconMaterial.RenderTransform>
                                                            <iconPacks:PackIconMaterial.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </iconPacks:PackIconMaterial.Triggers>
                                                        </iconPacks:PackIconMaterial>
                                                        <TextBlock Text="Đang xử lý qua Winget..." FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" Foreground="#888888" VerticalAlignment="Center"
                                                               Visibility="{Binding DownloadProgressPercent, Converter={StaticResource NonNegativeToVisConverter}}"
                                                               Text="{Binding DownloadProgressPercent, StringFormat='{}{0}%'}"/>
                                                </Grid>

                                                <!-- MỚI: Dòng chi tiết "X MB / Y MB  •  Z MB/s" - chỉ hiện khi có % thật (không hiện cho Winget) -->
                                                <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="11" Foreground="#666666"
                                                           Visibility="{Binding DownloadProgressPercent, Converter={StaticResource NonNegativeToVisConverter}}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}   •   {1}">
                                                            <Binding Path="DownloadProgressText"/>
                                                            <Binding Path="DownloadSpeedText"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Trạng thái rỗng -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalSoftwareCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconMaterial Kind="CloudOffOutline" Width="32" Height="32" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Thư viện chưa có phần mềm nào" Foreground="#777777" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
