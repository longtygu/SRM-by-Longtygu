<Window x:Class="SRM_by_Longtygu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SRM by Longtygu - Deployment Center" Height="800" Width="1500"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="14"
        WindowStyle="None" ResizeMode="CanResize">

    <!-- Bỏ viền/title bar trắng mặc định của Windows, thay bằng title bar tự vẽ bên dưới,
         vẫn giữ khả năng kéo resize ở viền cửa sổ -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- STYLE NÚT TITLE BAR (Minimize / Maximize / Close) ĐỒNG BỘ MÀU APP -->
        <Storyboard x:Key="ContentFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE NÚT BẤM SIDEBAR CHUẨN WINDOWS 11 FLUENT DESIGN -->
        <Style TargetType="Button" x:Key="FluentSidebarButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Bo góc 6px đặc trưng của Windows 11 -->
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TITLE BAR TỰ VẼ ============ -->
        <Border Grid.Row="0" Background="#282828" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + tên app -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="False">
                    <iconPacks:PackIconMaterial Kind="HexagonMultiple" Width="14" Height="14" Foreground="#60CDFF" Margin="0,0,8,0"/>
                    <TextBlock Text="Software Repository Manager by Longtygu" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Vùng trống để kéo di chuyển cửa sổ -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Nút Minimize / Maximize / Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ NỘI DUNG GỐC CỦA APP ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BẢNG ĐIỀU KHIỂN BÊN TRÁI (SIDEBAR) -->
            <Border Grid.Column="0" Background="#282828" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Chia Sidebar thành 3 hàng: Logo - Menu chính - Menu Cài đặt & Giới thiệu -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO & TIÊU ĐỀ -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Border Background="#333333" Padding="10" CornerRadius="8">
                            <iconPacks:PackIconMaterial Kind="HexagonMultiple" Width="24" Height="24" Foreground="#60CDFF"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SRM" FontWeight="Bold" FontSize="20" Foreground="#FFFFFF"/>
                            <TextBlock Text="by Longtygu" FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- MENU CHÍNH -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,16,0" Foreground="#60CDFF"/>
                                <TextBlock Text="{DynamicResource Menu_Dashboard}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateLibraryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Database" Width="20" Height="20" Margin="0,0,16,0" Foreground="#6CCB5F"/>
                                <TextBlock Text="{DynamicResource Menu_Library}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateResourceFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderMultiple" Width="20" Height="20" Margin="0,0,16,0" Foreground="#FF9800"/>
                                <TextBlock Text="THƯ VIỆN TÀI NGUYÊN" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- MỚI: Trang riêng "Trung tâm cập nhật" -->
                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateUpdateCenterCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloudSyncOutline" Width="20" Height="20" Margin="0,0,16,0" Foreground="#7C3AED"/>
                                <TextBlock Text="TRUNG TÂM CẬP NHẬT" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateDeploymentCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20" Margin="0,0,16,0" Foreground="#FCE100"/>
                                <TextBlock Text="{DynamicResource Menu_Deployment}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigatePresetsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="PackageVariant" Width="20" Height="20" Margin="0,0,16,0" Foreground="#C381FD"/>
                                <TextBlock Text="{DynamicResource Menu_Presets}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding ShowUninstallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Delete" Width="20" Height="20" Margin="0,0,16,0" Foreground="#FF99A4"/>
                                <TextBlock Text="GỠ CÀI ĐẶT TÙY CHỌN" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateToolsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ToolboxOutline" Width="20" Height="20" Margin="0,0,16,0" Foreground="#FFB86C"/>
                                <TextBlock Text="CÔNG CỤ MỞ RỘNG" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- CÀI ĐẶT & THÔNG TIN -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <Separator Background="#3E3E3E" Margin="24,0,24,10" Height="1"/>

                        <!-- Nút Cài Đặt -->
                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding NavigateSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Cog" Width="20" Height="20" Margin="0,0,16,0" Foreground="#CCCCCC"/>
                                <TextBlock Text="{DynamicResource Menu_Settings}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ĐÃ THÊM: Nút mở Hộp thoại Giới thiệu -->
                        <Button Style="{StaticResource FluentSidebarButtonStyle}" Command="{Binding ShowAboutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="20" Height="20" Margin="0,0,16,0" Foreground="#888888"/>
                                <TextBlock Text="THÔNG TIN APP" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- KHU VỰC HIỂN THỊ NỘI DUNG (MAIN CONTENT) -->
            <Border Grid.Column="1" Background="#202020">
                <ContentControl x:Name="MainContentControl" Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
