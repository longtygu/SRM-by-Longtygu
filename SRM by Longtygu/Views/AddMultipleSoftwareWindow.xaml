<Window x:Class="SRM_by_Longtygu.Views.AddMultipleSoftwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Thêm nhiều phần mềm cùng lúc" Height="720" Width="1150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 0. STYLE NÚT ĐÓNG (CLOSE BUTTON) -->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1. STYLE Ô NHẬP LIỆU (TEXTBOX) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="true">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. STYLE NÚT BẤM (BUTTON) -->
        <Style TargetType="Button" x:Key="FluentButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. STYLE CHECKBOX -->
        <Style TargetType="CheckBox" x:Key="FluentCheckBoxStyle">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A" Background="#282828" VerticalAlignment="Center" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial x:Name="CheckIcon" Kind="Check" Foreground="#000000" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" FontWeight="Bold"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#60CDFF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60CDFF"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. FIX TRIỆT ĐỂ COMBOBOX -->
        <Style TargetType="ComboBox" x:Key="FluentComboBoxStyle">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Nút mũi tên và Nền -->
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#333333"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Chữ hiển thị -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <!-- Bảng Popup (Menu thả xuống) -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#282828" BorderBrush="#454545" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250" CornerRadius="4" Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Định dạng từng dòng (Item) trong ComboBox -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,2">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#60CDFF"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. STYLE THANH CUỘN (SCROLLBAR) -->
        <Style x:Key="DarkThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. STYLE LISTBOXITEM CHO HÀNG ĐỢI -->
        <Style TargetType="ListBoxItem" x:Key="QueueItemStyle">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#242424" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#60CDFF"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#242F38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- BỌC TOÀN BỘ WINDOW ĐỂ TẠO BO GÓC VÀ NỀN DARK MODE -->
    <Border Background="#202020" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <!-- Hàng cho Thanh Tiêu đề (Title bar) -->
                <RowDefinition Height="*"/>
                <!-- Hàng cho Nội dung chính -->
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconMaterial Kind="PackageVariantPlus" Foreground="#60CDFF" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thêm nhiều phần mềm cùng lúc" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nút Đóng (X) -->
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="45" Click="CloseButton_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- NỘI DUNG CHÍNH -->
            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*"/>
                        <!-- Cột Trái: Hàng đợi -->
                        <ColumnDefinition Width="24"/>
                        <!-- Rãnh giữa -->
                        <ColumnDefinition Width="6.8*"/>
                        <!-- Cột Phải: Chi tiết item đang chọn -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= CỘT TRÁI: HÀNG ĐỢI FILE ================= -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Tiêu đề -->
                            <RowDefinition Height="Auto"/>
                            <!-- Toolbar thêm file -->
                            <RowDefinition Height="Auto"/>
                            <!-- Category chung -->
                            <RowDefinition Height="*"/>
                            <!-- Danh sách hàng đợi -->
                            <RowDefinition Height="Auto"/>
                            <!-- Nút Lưu tất cả -->
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Hàng đợi phần mềm" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0">
                                <Run Text="{Binding Queue.Count, Mode=OneWay}"/>
                                <Run Text=" phần mềm đang chờ xử lý"/>
                            </TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding AddFilesCommand}" Style="{StaticResource FluentButtonStyle}" Background="#60CDFF" Padding="0,10" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="FilePlus" Foreground="#000000" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm file..." Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding ClearQueueCommand}" Style="{StaticResource FluentButtonStyle}" Background="#3E3E3E" Padding="14,10" ToolTip="Xóa toàn bộ hàng đợi">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ExistingCategories}"
                                      SelectedItem="{Binding SharedCategory, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FluentComboBoxStyle}" Height="38" Margin="0,0,8,0"
                                      ToolTip="Danh mục chung"/>
                            <Button Grid.Column="1" Command="{Binding ApplyCategoryToAllCommand}" Style="{StaticResource FluentButtonStyle}" Background="#3E3E3E" Padding="10,10" ToolTip="Áp dụng danh mục này cho toàn bộ hàng đợi">
                                <TextBlock Text="Áp dụng" FontSize="12"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="3" Background="#1A1A1A" CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
                            <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="6"
                                     ItemContainerStyle="{StaticResource QueueItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,4,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,0">
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding Category, Mode=OneWay}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    VerticalAlignment="Top" Padding="4" ToolTip="Xóa khỏi hàng đợi">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Foreground="#777777"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button Grid.Row="4" Command="{Binding SaveAllCommand}" Style="{StaticResource FluentButtonStyle}" Background="#16A34A" Padding="15,12" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock Text="Lưu tất cả &amp; Xử lý" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- VÁCH NGĂN MỜ GIỮA 2 CỘT -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#3E3E3E" Margin="0,10"/>

                    <!-- ================= CỘT PHẢI: CHI TIẾT ITEM ĐANG CHỌN ================= -->
                    <Grid Grid.Column="2">

                        <!-- Trạng thái rỗng: chưa chọn item nào -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <iconPacks:PackIconMaterial Kind="PackageVariantPlus" Width="48" Height="48" Foreground="#454545" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Chọn 1 phần mềm trong hàng đợi để chỉnh sửa chi tiết," Foreground="#777777" HorizontalAlignment="Center"/>
                            <TextBlock Text="hoặc bấm &quot;Thêm file...&quot; để bắt đầu." Foreground="#777777" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Form chi tiết cho SelectedEntry -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Chi tiết phần mềm" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#FFFFFF"/>

                                    <TextBlock Text="File cài đặt" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedEntry.FilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Command="{Binding SelectIconCommand}" Content="Đổi Icon..."
                                                Style="{StaticResource FluentButtonStyle}" Background="#3E3E3E" Padding="16,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding SelectedEntry.StatusMessage}" Foreground="{Binding SelectedEntry.StatusBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <CheckBox IsChecked="{Binding SelectedEntry.IsSafeToSilentInstall}" Style="{StaticResource FluentCheckBoxStyle}" Margin="0,0,0,20">
                                        <TextBlock Text="Kích hoạt cài đặt ngầm (Khuyến cáo TẮT nếu phần mềm có kèm Adware/Quảng cáo)" Foreground="#FF9F0A" TextWrapping="Wrap"/>
                                    </CheckBox>

                                    <!-- Tên & Phiên bản -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Tên phần mềm" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBox Text="{Binding SelectedEntry.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Phiên bản" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBox Text="{Binding SelectedEntry.Version, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Nhà phát triển & Danh mục -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Nhà phát triển (Publisher)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBox Text="{Binding SelectedEntry.Publisher, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Danh mục (Category)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                            <ComboBox ItemsSource="{Binding ExistingCategories}"
                                                      SelectedItem="{Binding SelectedEntry.Category, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource FluentComboBoxStyle}" Height="40"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Silent Commands -->
                                    <TextBlock Text="Lệnh cài đặt ngầm (Silent Install Command)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding SelectedEntry.SilentCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                                    <TextBlock Text="Lệnh gỡ cài đặt ngầm (Silent Uninstall Command)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding SelectedEntry.SilentUninstallCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                                    <CheckBox IsChecked="{Binding SelectedEntry.IsPortable}" Style="{StaticResource FluentCheckBoxStyle}" Margin="0,0,0,20">
                                        <TextBlock Text="Đây là bản Portable (Chạy trực tiếp, không cần cài đặt)" Foreground="#FFFFFF"/>
                                    </CheckBox>

                                    <TextBlock Text="CD-Key / Giấy phép (License Key)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding SelectedEntry.LicenseKey, UpdateSourceTrigger=PropertyChanged}" Foreground="#FCE100" FontWeight="Bold" Margin="0,0,0,16"/>

                                    <TextBlock Text="Mô tả ngắn" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding SelectedEntry.Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" TextWrapping="Wrap" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                                    <TextBlock Text="Ghi chú / Hướng dẫn (Readme)" Foreground="#AAAAAA" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding SelectedEntry.Readme, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="1" Command="{Binding RemoveEntryCommand}" CommandParameter="{Binding SelectedEntry}"
                                    Style="{StaticResource FluentButtonStyle}" Background="#3E3E3E" Padding="15,10" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Margin="0,0,10,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                    <TextBlock Text="Xóa mục này khỏi hàng đợi" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- MÀN HÌNH CHỜ (LOADING OVERLAY) -->
                <Grid Background="#E6121212" Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                        <iconPacks:PackIconMaterial Kind="Autorenew" Width="50" Height="50" Foreground="#60CDFF" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </iconPacks:PackIconMaterial.Triggers>
                            <iconPacks:PackIconMaterial.RenderTransform>
                                <RotateTransform CenterX="25" CenterY="25"/>
                            </iconPacks:PackIconMaterial.RenderTransform>
                        </iconPacks:PackIconMaterial>
                        <TextBlock Text="{Binding CurrentProcessingName, StringFormat='Đang xử lý: {0}'}" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Margin="0,10,0,10" HorizontalAlignment="Center">
                            <Run Text="{Binding ProcessedCount, Mode=OneWay}" Foreground="#60CDFF" FontWeight="Bold"/>
                            <Run Text=" / " Foreground="#AAAAAA"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="#AAAAAA"/>
                        </TextBlock>
                        <ProgressBar Value="{Binding ProcessedCount, Mode=OneWay}" Maximum="{Binding TotalCount, Mode=OneWay}" Height="8" Background="#2D2D2D" Foreground="#60CDFF" BorderThickness="0"/>
                        <TextBlock Text="Vui lòng không tắt ứng dụng" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
