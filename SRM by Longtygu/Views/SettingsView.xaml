<UserControl x:Class="SRM_by_Longtygu.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <UserControl.Resources>
        <!-- BỔ SUNG: Converter để chuyển đổi True/False thành Ẩn/Hiện -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="FluentSettingsButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar" x:Key="FluentProgressBar">
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BỔ SUNG: STYLE CHO NÚT BẤM THU GỌN/MỞ RỘNG (TOGGLE BUTTON) -->
        <Style TargetType="ToggleButton" x:Key="LogExpanderStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="8,4" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Console" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                <iconPacks:PackIconMaterial x:Name="ArrowIcon" Kind="ChevronDown" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowIcon" Property="Kind" Value="ChevronUp"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ TRANG -->
        <TextBlock Grid.Row="0" Text="{DynamicResource Menu_Settings}" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- ================= 1. CÀI ĐẶT NGÔN NGỮ ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Language / Ngôn ngữ" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Chuyển đổi ngôn ngữ hiển thị tức thời giữa Tiếng Anh và Tiếng Việt." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ToggleLanguageCommand}" Style="{StaticResource FluentSettingsButton}" Background="#0284C7">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Translate" Margin="0,0,10,0" VerticalAlignment="Center" Width="18" Height="18"/>
                                <TextBlock Text="Toggle Language" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= 2. TRUNG TÂM BẢO TRÌ (BACKUP & RESTORE) ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Backup &amp; Restore / Bảo trì hệ thống" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Quản lý toàn bộ dữ liệu ứng dụng, bao gồm sao lưu an toàn và khôi phục cài đặt gốc." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,24">
                            <!-- Nút Sao Lưu -->
                            <Button Command="{Binding FullBackupCommand}" Style="{StaticResource FluentSettingsButton}" Background="#D97706" Margin="0,0,12,12" ToolTip="Nén toàn bộ file cài đặt, hình ảnh và dữ liệu">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ArchiveArrowUp" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Xuất toàn bộ dữ liệu (Full Zip)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Phục Hồi -->
                            <Button Command="{Binding RestoreCommand}" Style="{StaticResource FluentSettingsButton}" Background="#7E22CE" Margin="0,0,12,12" ToolTip="Nạp lại dữ liệu từ file Full Backup (.zip)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="BackupRestore" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phục hồi dữ liệu (Restore)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Xóa Sạch -->
                            <Button Command="{Binding ResetCommand}" Style="{StaticResource FluentSettingsButton}" Background="#C42B1C" Margin="0,0,12,12" ToolTip="Xóa sạch toàn bộ cấu trúc và file cài đặt (Cảnh báo)">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteForever" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Làm sạch hệ thống (Reset)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- THANH TRẠNG THÁI, TIẾN ĐỘ & MÀN HÌNH LOG -->
                        <Border Grid.Row="2" Background="#222222" Padding="16" CornerRadius="6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding BackupStatus}" Foreground="#6CCB5F" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BackupProgress, StringFormat={}{0:0.0}%}" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar Style="{StaticResource FluentProgressBar}" Value="{Binding BackupProgress}" Minimum="0" Maximum="100"/>

                                <!-- NÚT BẤM THU GỌN/MỞ RỘNG KHAY LOG -->
                                <ToggleButton Content="Nhật ký hệ thống (Log)" 
                                              IsChecked="{Binding IsLogExpanded, Mode=TwoWay}" 
                                              Style="{StaticResource LogExpanderStyle}"/>

                                <!-- MÀN HÌNH LOG (Bị ẩn nếu IsLogExpanded = False) -->
                                <Border Background="#0C0C0C" CornerRadius="4" BorderBrush="#333333" BorderThickness="1"
                                        Height="180" Margin="0,8,0,0"
                                        Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                                    <ListBox x:Name="LogConsole" 
                                             ItemsSource="{Binding OperationLogs}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Margin="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Padding" Value="2,4"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 2B. CẬP NHẬT ỨNG DỤNG (DataContext = AppUpdateViewModel, gán trong code-behind) ================= -->
                <Border x:Name="AppUpdateCard" Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="App update / Cập nhật ứng dụng" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Kiểm tra phiên bản mới qua nguồn Github. Ứng dụng chỉ thông báo và mở trang tải về, không tự thay đổi file hay dữ liệu của bạn." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,4">
                                    <Run Text="Phiên bản đang chạy: "/>
                                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding LastCheckedText}" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource FluentSettingsButton}" Background="#0284C7" ToolTip="Gọi GitHub để xem có bản phát hành mới hơn bản đang chạy không">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Update" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CheckButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- KẾT QUẢ KIỂM TRA -->
                        <Border Grid.Row="2" Background="#222222" Padding="16" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <!-- Chỉ hiện khi có bản mới -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="Ghi chú phát hành" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding ReleaseNotesPreview}" FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Command="{Binding OpenReleasePageCommand}" Style="{StaticResource FluentSettingsButton}" Background="#16A34A" HorizontalAlignment="Left" ToolTip="Mở trang Release của bản mới trên GitHub bằng trình duyệt">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="OpenInNew" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xem trang tải về" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 3. PLACEHOLDER (COMING SOON) ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Opacity="0.6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconMaterial Grid.Column="0" Kind="ApplicationCog" Foreground="#888888" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="System Preferences (Coming soon)" FontSize="18" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                            <TextBlock Text="Cấu hình nâng cao: Theme Mode, Tự động tạo Restore Point, Đường dẫn dữ liệu mặc định..." FontSize="14" Foreground="#777777" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>