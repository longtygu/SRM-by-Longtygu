<Window x:Class="SRM_by_Longtygu.Views.ResourceFileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:SRM_by_Longtygu.Helpers"
        Title="Chỉnh sửa Tài nguyên" Height="730" Width="680"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" 
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Window.Resources>
        <helpers:ImagePathConverter x:Key="ImgConverter"/>
        <helpers:EditorIconPreviewConverter x:Key="IconPreviewConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FluentButtonStyle">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MiniIconButtonStyle">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="FluentComboBoxStyle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0 Z" Fill="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,35,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#282828" BorderBrush="#454545" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200" CornerRadius="4" Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#202020" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <iconPacks:PackIconMaterial Kind="FileDocumentEdit" Foreground="#60CDFF" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thông tin Tài nguyên" Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="50" Click="CloseButton_Click">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="14" Height="14"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="30,15,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#282828" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="Bước 1: Chọn file hoặc thư mục trên thiết bị" Foreground="#60CDFF" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="Hệ thống sẽ tự động copy vào ứng dụng, quét dung lượng và nhận diện icon" Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Đã sửa Orientation thành Vertical ở StackPanel này -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <Button Command="{Binding SelectFileCommand}" Style="{StaticResource FluentButtonStyle}" Background="#0284C7" Padding="20,12" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileSearch" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chọn File" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelectFolderCommand}" Style="{StaticResource FluentButtonStyle}" Background="#333333" Padding="20,12" ToolTip="Chọn 1 thư mục chứa nhiều file nhỏ (VD: bộ driver, bộ tool)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chọn Thư Mục" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12,8" Margin="0,15,0,0"
                                Visibility="{Binding IsSourceFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Foreground="#60CDFF" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <TextBlock Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Đang ở chế độ THƯ MỤC — toàn bộ file bên trong sẽ được copy nguyên vẹn (kể cả thư mục con)."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding SelectIconCommand}" Style="{StaticResource FluentButtonStyle}" Background="#333333" Width="80" Height="80" Margin="0,0,20,0" ToolTip="Đổi Icon thủ công">
                            <Grid>
                                <iconPacks:PackIconMaterial Kind="ImagePlus" Foreground="#888888" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="#333333">
                                    <Image Stretch="Uniform">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource IconPreviewConverter}">
                                                <Binding Path="IconPath"/>
                                                <Binding Path="SourceFilePath"/>
                                                <Binding Path="ExistingFilePath"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <Button Command="{Binding ResetIconCommand}" Style="{StaticResource MiniIconButtonStyle}"
                                        Width="24" Height="24" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                                        ToolTip="Bỏ icon tự chọn, dùng icon tự động"
                                        Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tên hiển thị (Có thể sửa lại cho đẹp)" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="18" Margin="0" MinHeight="45"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Danh mục (Category)" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Style="{StaticResource FluentComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dung lượng (Tự động)" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Foreground="#FCE100" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tên file gốc (Tự động cập nhật)" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Foreground="#CCCCCC"/>

                    <TextBlock Text="Mô tả / Ghi chú chi tiết" Foreground="#AAAAAA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Hủy Bỏ" Style="{StaticResource FluentButtonStyle}" Background="#333333" Padding="28,14" Margin="0,0,15,0" FontSize="15" Click="Cancel_Click"/>
                    <Button Style="{StaticResource FluentButtonStyle}" Background="#16A34A" Padding="36,14" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LƯU DỮ LIỆU" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>