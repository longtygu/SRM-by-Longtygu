<UserControl x:Class="SRM_by_Longtygu.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" Foreground="#FFFFFF"
             FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- STYLE NÚT BẤM CHUẨN WINDOWS 11 FLUENT DARK MODE -->
        <Style x:Key="FluentTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tùy chỉnh ScrollBar tối màu cho phần Nguyên lý hoạt động -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#555555" CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nâng cấp Style cho các đoạn văn bản kỹ thuật chi tiết -->
        <Style x:Key="DetailTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
        </Style>

        <!-- Style cho từng dòng trong danh sách Nhật ký hoạt động, đổi màu viền trái theo Level -->
        <Style x:Key="LogRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="#60CDFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARNING">
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="BorderBrush" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogLevelBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#60CDFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="WARNING">
                    <Setter Property="Background" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Background" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: MENU CHỌN -->
        <Border Grid.Column="0" Background="#282828" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">

                <Button Command="{Binding ShowAppInfoCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingAppInfo}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="#60CDFF"/>
                        <TextBlock Text="Thông tin Ứng dụng" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowOperatingPrincipleCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingOperatingPrinciple}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Cogs" Width="18" Height="18" Margin="0,0,12,0" Foreground="#FF9800"/>
                        <TextBlock Text="Nguyên lý hoạt động" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ShowActivityLogCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShowingActivityLog}" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="#6CCB5F"/>
                        <TextBlock Text="Nhật ký hoạt động" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- CỘT PHẢI: NỘI DUNG HIỂN THỊ -->
        <Grid Grid.Column="1" Margin="40,30,40,30">

            <!-- GIAO DIỆN 1: THÔNG TIN APP -->
            <StackPanel Visibility="{Binding IsShowingAppInfo, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Background="#2D2D2D" Width="64" Height="64" CornerRadius="12" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="HexagonMultiple" Width="36" Height="36" Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Software Repository Manager" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="Phiên bản 1.0.0 ( Test )" FontSize="14" Foreground="#888888" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#282828" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                    <FlowDocumentScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                        <FlowDocument FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="15" Foreground="#CCCCCC" TextAlignment="Justify" PagePadding="5">
                            <Paragraph LineHeight="24">
                                <Floater HorizontalAlignment="Left" Width="180" Margin="0,0,20,10">
                                    <BlockUIContainer>
                                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#444444" BorderThickness="1">
                                            <Image Source="pack://application:,,,/Resources/Images/author_portrait.png" Stretch="UniformToFill" Height="240" Width="180" ToolTip="Tác giả"/>
                                        </Border>
                                    </BlockUIContainer>
                                </Floater>
                                <Run Text="Software Repository Manager (SRM) chưa đến mức để coi là dự án mà là 1 sản phẩm cá nhân LÀM CHO VUI, xuất phát từ nhu cầu cần quản lý các bộ cài với yêu cầu phải đơn giản, nhẹ và đặc biệt có thể chạy độc lập và portable trên các thiết bị ngoại vi như usb, ổ cứng rời mà không cần phải sửa đổi quá nhiều."/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="70% code tạo ra bởi AI, cá nhân tôi chỉ mang tính định hướng, prom tính năng, fix các lỗi liên quan đến cấu trúc và tên biến, các lỗi có lượng văn bản lớn mà AI không thể đọc hết trong 1 phiên, testing, đóng gói cũng như publish công khai nên mã nguồn phần mềm đều được share cho bất kỳ ai muốn sửa đổi cũng như phát triển riêng dựa trên khung phần mềm này, tất nhiên yêu cầu khai báo tên phiên bản gốc :) ."/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="100% code sử dụng là C# trên nền tảng Visual Studio kết hợp với Blend để chỉnh sửa giao diện, sử dụng trình quản lý database SQLite, siêu gọn và đơn giản, tôn chỉ nhẹ nhất có thể, đơn giản tối đa nhưng phải đầy đủ tính năng."/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="các tính năng chính hiện tại đã có trong phiên bản này bao gồm : quản lý các bộ cài | quản lý các tài nguyên | cài đặt đơn lẻ / hàng loạt / theo set | các bộ cài đính kèm nhiều phiên bản và tài nguyên đính kèm | bộ gỡ cài đặt cơ bản có thể phân biệt phần mềm hệ thống và cá nhân | hệ thống quét cập nhật tự động với 120 app đã được liệt kê sẵn và đánh dấu | tích hợp sẵn 5 tool cơ bản."/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="do phần mềm phát triển cá nhân trong thời gian rảnh có thể xảy ra lỗi vô tình bỏ qua trong quá trình test nên nếu phát hiện bug, hãy liên hệ cho mình qua Facebook bằng nút bên dưới."/>
                            </Paragraph>
                            <BlockUIContainer>
                                <Button x:Name="FacebookButton"
                                        Click="FacebookButton_Click"
                                        Style="{StaticResource FluentTabButtonStyle}"
                                        Background="#2D2D2D" Foreground="#FFFFFF"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                                        ToolTip="https://www.facebook.com/longtygu/">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="OpenInNew" Width="16" Height="16" Margin="0,0,10,0" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="Liên hệ qua Facebook" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </BlockUIContainer>
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Border>
            </StackPanel>

            <!-- GIAO DIỆN 2: ĐẶC TẢ KIẾN TRÚC & NGUYÊN LÝ HOẠT ĐỘNG (BẢN CHI TIẾT) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingOperatingPrinciple}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                    <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Đặc tả Kiến trúc &amp; Nguyên lý Hoạt động" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bọc nội dung trong Card có ScrollViewer -->
                <Border Grid.Row="1" Background="#282828" CornerRadius="8" Padding="25" BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="0,0,10,0">

                            <!-- 1. Kiến trúc CSDL -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="Database" Width="20" Height="20" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="1. Kiến trúc Cơ sở Dữ liệu &amp; Quản lý Trạng thái" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="Hệ thống lưu trữ được thiết kế hoàn toàn theo hướng phi tập trung (Serverless) thông qua engine SQLite. Lớp "/>
                                    <Run Text="DatabaseBootstrapper" FontWeight="Bold" Foreground="#6CCB5F"/>
                                    <Run Text=" sẽ tự động tính toán thư mục gốc ("/>
                                    <Run Text="AppDomain.CurrentDomain.BaseDirectory" FontStyle="Italic"/>
                                    <Run Text=") để sinh ra file "/>
                                    <Run Text="library.db" FontWeight="Bold"/>
                                    <Run Text=". Điều này đảm bảo tính "/>
                                    <Run Text="Portable" FontWeight="Bold"/>
                                    <Run Text=" tuyệt đối khi ứng dụng chạy từ USB. Tính toàn vẹn của cấu trúc dữ liệu nhiều chiều (như Software, Versions, Presets) được khóa chặt bằng cơ chế khóa ngoại "/>
                                    <Run Text="FOREIGN KEY" FontWeight="Bold"/>
                                    <Run Text=" kết hợp với "/>
                                    <Run Text="ON DELETE CASCADE" FontWeight="Bold" Foreground="#FF5252"/>
                                    <Run Text=". Khi một phần mềm gốc bị gỡ bỏ, Database tự động dọn sạch các phiên bản con và bản đồ cấu hình (Preset Mapping) liên quan, chống rác dữ liệu ở cấp độ thấp nhất. Ngoài ra, Domain Models tích hợp thuật toán quy đổi thời gian thực, tự động parse dữ liệu Byte khô khan thành định dạng GB/MB chuẩn UI."/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 2. Luồng Triển khai -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20" Foreground="#FF5252" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="2. Luồng Thực thi Cài đặt Cấp thấp (Deployment Service)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="Mô-đun điều phối (DeploymentViewModel) hoạt động độc lập với logic xử lý file. Trước bất kỳ chu trình cài đặt lô nào, hệ thống kích hoạt PowerShell ẩn với quyền cao nhất ("/>
                                    <Run Text="Verb = 'runas'" FontStyle="Italic"/>
                                    <Run Text=") để gọi hàm "/>
                                    <Run Text="Enable-ComputerRestore" FontWeight="Bold" Foreground="#60CDFF"/>
                                    <Run Text=" thông qua API Windows. Chốt chặn này đảm bảo hệ điều hành luôn có đường lui nếu bộ cài gây xung đột.&#x0a;&#x0a;"/>
                                    
                                    <Run Text="Đối với phần mềm Portable:" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Run Text=" Hệ thống sử dụng "/>
                                    <Run Text="ZipFile.ExtractToDirectory" FontStyle="Italic"/>
                                    <Run Text=" để giải nén trực tiếp vào thư mục đích (ví dụ C:\PortableApps), sau đó quét đệ quy tìm tệp (.exe) chính và đẩy Script PowerShell tự động tạo Shortcut ra Desktop.&#x0a;&#x0a;"/>

                                    <Run Text="Đối với Silent Installers:" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Run Text=" Để giải quyết bài toán giao diện bị 'đóng băng' do tiến trình cài đặt không trả về dữ liệu luồng, "/>
                                    <Run Text="RunSilentInstallAsync" FontWeight="Bold"/>
                                    <Run Text=" sử dụng thuật toán vòng lặp thăm dò ("/>
                                    <Run Text="!process.HasExited" FontStyle="Italic"/>
                                    <Run Text="). Nó liên tục nạp các giá trị giả lập ngẫu nhiên ("/>
                                    <Run Text="Random.Next" FontStyle="Italic"/>
                                    <Run Text=") để đẩy thanh Progress Bar từ từ lên mốc 95% và neo lại đó chờ tiến trình hoàn tất. Đây là một thủ thuật UX cực kỳ tinh vi giúp phần mềm hoạt động mượt mà."/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 3. Analyzer -->
                            <StackPanel Margin="0,0,0,32">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="Brain" Width="20" Height="20" Foreground="#C381FD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="3. Engine Phân tích Cấu trúc Đóng gói (Static Analyzer)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="Lõi "/>
                                    <Run Text="InstallerAnalyzer" FontWeight="Bold" Foreground="#C381FD"/>
                                    <Run Text=" hoạt động như một máy quét nhị phân tĩnh (Static Binary Scanner). Thay vì nạp toàn bộ bộ cài vào RAM gây tràn bộ nhớ, hệ thống khởi tạo một Stream Buffer giới hạn nghiêm ngặt ở mức "/>
                                    <Run Text="2MB dữ liệu đầu tiên (2048 * 1024 bytes)" FontWeight="Bold"/>
                                    <Run Text=". Khối dữ liệu nhị phân này được giải mã sang bảng mã ASCII để dò tìm các dấu hiệu (Signatures) của trình biên dịch.&#x0a;&#x0a;Nhờ cơ chế này, SRM tự động phân biệt được bộ cài Inno Setup ("/>
                                    <Run Text="/VERYSILENT" FontStyle="Italic"/>
                                    <Run Text="), bộ cài Nullsoft/NSIS ("/>
                                    <Run Text="/S" FontStyle="Italic"/>
                                    <Run Text="), hay WiX Toolset ("/>
                                    <Run Text="-quiet" FontStyle="Italic"/>
                                    <Run Text=") với tốc độ dưới 0.1 giây, từ đó tiêm chính xác các biến "/>
                                    <Run Text="INSTALLDIR" FontWeight="Bold"/>
                                    <Run Text=" điều hướng ổ đĩa mà không cần người dùng can thiệp."/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 4. Plugin -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="PuzzleOutline" Width="20" Height="20" Foreground="#FFB86C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="4. Kiến trúc Mở &amp; Dependency Injection (Hệ sinh thái Plugin)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DetailTextStyle}">
                                    <Run Text="Được xây dựng trên nền tảng Dependency Injection (DI) hiện đại, toàn bộ tính năng phụ trợ (như Check RAM, Disk Health) không bị nhồi nhét vào lõi chính. Thay vào đó, chúng bị cô lập thông qua giao thức "/>
                                    <Run Text="IToolModule" FontWeight="Bold" Foreground="#FFB86C"/>
                                    <Run Text=". Các DLL bên ngoài chỉ cần implements interface này để khai báo "/>
                                    <Run Text="Id, IconKind" FontStyle="Italic"/>
                                    <Run Text=" cho UI tự động render thẻ (card). Đặc biệt, thông qua hàm "/>
                                    <Run Text="CreateView(IServiceProvider)" FontWeight="Bold"/>
                                    <Run Text=", SRM truyền toàn bộ các Service nội bộ (Database, Logging) ngược vào các Plugin, cho phép chúng tương tác sâu với phần cứng hệ thống như một module nguyên bản."/>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- GIAO DIỆN 3: NHẬT KÝ HOẠT ĐỘNG (LOG VIEWER) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingActivityLog}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline" Width="28" Height="28" Foreground="#6CCB5F" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Nhật ký hoạt động" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Thanh công cụ: chọn ngày, làm mới, mở thư mục -->
                <Border Grid.Row="1" Background="#282828" CornerRadius="8" Padding="15,12" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Ngày:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLogDates}"
                                  SelectedItem="{Binding SelectedLogDate}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='dd/MM/yyyy'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="{Binding LogStatusText}" Foreground="#888888" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="3" Content="Làm mới" Command="{Binding RefreshLogCommand}"
                                Style="{StaticResource FluentTabButtonStyle}" Margin="4,0" Padding="14,8"/>

                        <Button Grid.Column="4" Content="Mở thư mục Log" Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource FluentTabButtonStyle}" Margin="4,0" Padding="14,8"/>
                    </Grid>
                </Border>

                <!-- Danh sách log -->
                <Border Grid.Row="2" Background="#282828" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LogRowStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Style="{StaticResource LogLevelBadgeStyle}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="Bold" Foreground="#1A1A1A"/>
                                                </Border>
                                                <TextBlock Text="{Binding TimeDisplay}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="14"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#FF8A80" TextWrapping="Wrap" FontSize="12"
                                                       FontFamily="Consolas" Margin="0,6,0,0"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>