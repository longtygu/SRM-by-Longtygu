<UserControl x:Class="SRM_by_Longtygu.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <UserControl.Resources>
        <!-- BỔ SUNG: Converter để chuyển đổi True/False thành Ẩn/Hiện -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== COMBOBOX NGÔN NGỮ: nền tối, viền accent khi mở, danh sách bo góc ===== -->
        <Style x:Key="LangComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#2D2D2D" BorderBrush="#454545" BorderThickness="1" CornerRadius="8">
                            <iconPacks:PackIconMaterial Kind="ChevronDown" Width="11" Height="11" Foreground="#AAAAAA"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60CDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <iconPacks:PackIconMaterial x:Name="Tick" Grid.Column="1" Kind="Check" Width="14" Height="14"
                                                             Foreground="#60CDFF" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4A63"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangComboBoxStyle" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LangComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource LangComboToggleStyle}" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="5">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="LangComboItemTemplate">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Translate" Width="15" Height="15" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NativeName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Code}" FontSize="11.5" Foreground="#888888" VerticalAlignment="Center" Margin="10,1,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="Button" x:Key="FluentSettingsButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar" x:Key="FluentProgressBar">
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BỔ SUNG: STYLE CHO NÚT BẤM THU GỌN/MỞ RỘNG (TOGGLE BUTTON) -->
        <Style TargetType="ToggleButton" x:Key="LogExpanderStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="8,4" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Console" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                <iconPacks:PackIconMaterial x:Name="ArrowIcon" Kind="ChevronDown" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowIcon" Property="Kind" Value="ChevronUp"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ TRANG -->
        <TextBlock Grid.Row="0" Text="{DynamicResource Menu_Settings}" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- ================= 1. CÀI ĐẶT NGÔN NGỮ ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{DynamicResource Settings_LanguageTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Settings_LanguageDesc}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Settings_LanguageNote}" FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LangComboBoxStyle}"
                                  ItemTemplate="{StaticResource LangComboItemTemplate}"
                                  ItemsSource="{Binding SupportedLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- ================= 2. TRUNG TÂM BẢO TRÌ (BACKUP & RESTORE) ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="{DynamicResource Settings_MaintenanceTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Settings_MaintenanceDesc}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,24">
                            <!-- Nút Sao Lưu -->
                            <Button Command="{Binding FullBackupCommand}" Style="{StaticResource FluentSettingsButton}" Background="#D97706" Margin="0,0,12,12" ToolTip="{DynamicResource Settings_TipFullBackup}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ArchiveArrowUp" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings_OpFullBackup}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Phục Hồi -->
                            <Button Command="{Binding RestoreCommand}" Style="{StaticResource FluentSettingsButton}" Background="#7E22CE" Margin="0,0,12,12" ToolTip="{DynamicResource Settings_TipRestore}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="BackupRestore" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings_OpRestore}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Xóa Sạch -->
                            <Button Command="{Binding ResetCommand}" Style="{StaticResource FluentSettingsButton}" Background="#C42B1C" Margin="0,0,12,12" ToolTip="{DynamicResource Settings_TipReset}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="DeleteForever" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings_OpReset}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- THANH TRẠNG THÁI, TIẾN ĐỘ & MÀN HÌNH LOG -->
                        <Border Grid.Row="2" Background="#222222" Padding="16" CornerRadius="6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding BackupStatus}" Foreground="#6CCB5F" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding BackupProgress, StringFormat={}{0:0.0}%}" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar Style="{StaticResource FluentProgressBar}" Value="{Binding BackupProgress}" Minimum="0" Maximum="100"/>

                                <!-- NÚT BẤM THU GỌN/MỞ RỘNG KHAY LOG -->
                                <ToggleButton Content="{DynamicResource Settings_LogHeader}" 
                                              IsChecked="{Binding IsLogExpanded, Mode=TwoWay}" 
                                              Style="{StaticResource LogExpanderStyle}"/>

                                <!-- MÀN HÌNH LOG (Bị ẩn nếu IsLogExpanded = False) -->
                                <Border Background="#0C0C0C" CornerRadius="4" BorderBrush="#333333" BorderThickness="1"
                                        Height="180" Margin="0,8,0,0"
                                        Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                                    <ListBox x:Name="LogConsole" 
                                             ItemsSource="{Binding OperationLogs}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Margin="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Padding" Value="2,4"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 2B. CẬP NHẬT ỨNG DỤNG (DataContext = AppUpdateViewModel, gán trong code-behind) ================= -->
                <Border x:Name="AppUpdateCard" Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="{DynamicResource Settings_UpdateTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Settings_UpdateDesc}" FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,4">
                                    <Run Text="{DynamicResource Settings_RunningVersion}"/>
                                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding LastCheckedText}" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource FluentSettingsButton}" Background="#0284C7" ToolTip="{DynamicResource Settings_TipCheck}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Update" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CheckButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- KẾT QUẢ KIỂM TRA -->
                        <Border Grid.Row="2" Background="#222222" Padding="16" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <!-- Chỉ hiện khi có bản mới -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource Settings_ReleaseNotes}" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding ReleaseNotesPreview}" FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding OpenReleasePageCommand}" Style="{StaticResource FluentSettingsButton}" Background="#16A34A" Margin="0,0,12,0" ToolTip="{DynamicResource Settings_TipOpenRelease}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="OpenInNew" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Settings_ViewDownload}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Chỉ hiện khi bản phát hành có file zip + mã SHA256 do GitHub công bố -->
                                        <Button Command="{Binding DownloadUpdateCommand}" Style="{StaticResource FluentSettingsButton}" Background="#0284C7"
                                                Visibility="{Binding CanAutoDownload, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{DynamicResource Settings_TipInstall}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="Download" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DownloadButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Thanh tiến trình tải: phần trăm, dung lượng, tốc độ -->
                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowDownloadPanel, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Style="{StaticResource FluentProgressBar}" Value="{Binding DownloadProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding DownloadStatusText}" Foreground="{Binding DownloadStatusBrush}" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DownloadLocationText}" Foreground="#888888" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 3. PLACEHOLDER (COMING SOON) ================= -->
                <Border Background="#282828" CornerRadius="8" Padding="24" BorderBrush="#333333" BorderThickness="1" Opacity="0.6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconMaterial Grid.Column="0" Kind="ApplicationCog" Foreground="#888888" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_PrefsTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Settings_PrefsDesc}" FontSize="14" Foreground="#777777" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>